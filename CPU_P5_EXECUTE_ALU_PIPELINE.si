unit alu_mul_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,

    input   uint64              RESULT,
    input   uint5               DESTREG,
    input   uint1               SIGNX,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG
) <reginputs> {
    uint3               STATE = 1;

    COMMIT_DESTREG := DESTREG;
    COMMIT_RESULT := { SIGNX ? {32{RESULT[31,1]}} : RESULT[32,32], RESULT[0, 32] };
    COMMIT_RESULT_READY := STATE[2,1];

    always {
        onehot( STATE ) {
            case 0: { if( START ) { READY = 0; STATE = 2; RD[ DESTREG, 1 ] = 1; } }
            case 1: { STATE = 4; }
            case 2: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit alu_commit(
    output  uint32              RD,
    output  uint1               RESULT_READY,

    input   uint1               ALU_READY,
    output  uint1               ALU_ACK,
    input   uint64              ALU_RESULT,
    input   uint5               ALU_DESTREG,

    input   uint1               ALU_ADD_READY,
    output  uint1               ALU_ADD_ACK,
    input   uint64              ALU_ADD_RESULT,
    input   uint5               ALU_ADD_DESTREG,

    input   uint1               ALU_CSX_READY,
    output  uint1               ALU_CSX_ACK,
    input   uint64              ALU_CSX_RESULT,
    input   uint5               ALU_CSX_DESTREG,

    input   uint1               ALU_LOGIC_READY,
    output  uint1               ALU_LOGIC_ACK,
    input   uint64              ALU_LOGIC_RESULT,
    input   uint5               ALU_LOGIC_DESTREG,

    input   uint1               ALU_MUL_READY,
    output  uint1               ALU_MUL_ACK,
    input   uint64              ALU_MUL_RESULT,
    input   uint5               ALU_MUL_DESTREG,

    input   uint1               ALU_COND_READY,
    output  uint1               ALU_COND_ACK,
    input   uint64              ALU_COND_RESULT,
    input   uint5               ALU_COND_DESTREG,

    input   uint1               ALU_MNMX_READY,
    output  uint1               ALU_MNMX_ACK,
    input   uint64              ALU_MNMX_RESULT,
    input   uint5               ALU_MNMX_DESTREG,

    input   uint1               COMMIT_EXECUTE_ALU_RESULT_ACK,
    output  uint64              COMMIT_ALU_RESULT,
    output  uint5               COMMIT_ALU_REGISTER
) <reginputs> {
    ALU_ACK := 0;
    ALU_ADD_ACK := 0;
    ALU_CSX_ACK := 0;
    ALU_LOGIC_ACK := 0;
    ALU_MUL_ACK := 0;
    ALU_COND_ACK := 0;
    ALU_MNMX_ACK := 0;

    RESULT_READY := ALU_READY | ALU_ADD_READY | ALU_CSX_READY | ALU_LOGIC_READY | ALU_MUL_READY | ALU_COND_READY | ALU_MNMX_READY;
        RD := 1 << (
                          ALU_READY ? ALU_DESTREG :
                      ALU_ADD_READY ? ALU_ADD_DESTREG :
                      ALU_CSX_READY ? ALU_CSX_DESTREG :
                      ALU_LOGIC_READY ? ALU_LOGIC_DESTREG :
                      ALU_MUL_READY ? ALU_MUL_DESTREG :
                      ALU_COND_READY ? ALU_COND_DESTREG :
                      ALU_MNMX_READY ? ALU_MNMX_DESTREG :
                                      0
                  );

    always {
        if( ALU_READY ) {
            COMMIT_ALU_RESULT = ALU_RESULT;
            COMMIT_ALU_REGISTER = ALU_DESTREG;
            ALU_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
        } else {
            if( ALU_ADD_READY ) {
                COMMIT_ALU_RESULT = ALU_ADD_RESULT;
                COMMIT_ALU_REGISTER = ALU_ADD_DESTREG;
                ALU_ADD_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
            } else {
                if( ALU_CSX_READY ) {
                    COMMIT_ALU_RESULT = ALU_CSX_RESULT;
                    COMMIT_ALU_REGISTER = ALU_CSX_DESTREG;
                    ALU_CSX_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
                } else {
                    if( ALU_LOGIC_READY ) {
                        COMMIT_ALU_RESULT = ALU_LOGIC_RESULT;
                        COMMIT_ALU_REGISTER = ALU_LOGIC_DESTREG;
                        ALU_LOGIC_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
                    } else {
                        if( ALU_MUL_READY ) {
                            COMMIT_ALU_RESULT = ALU_MUL_RESULT;
                            COMMIT_ALU_REGISTER = ALU_MUL_DESTREG;
                            ALU_MUL_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
                        } else {
                            if( ALU_COND_READY ) {
                                COMMIT_ALU_RESULT = ALU_COND_RESULT;
                                COMMIT_ALU_REGISTER = ALU_COND_DESTREG;
                                ALU_COND_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
                            } else {
                                if( ALU_MNMX_READY ) {
                                    COMMIT_ALU_RESULT = ALU_MNMX_RESULT;
                                    COMMIT_ALU_REGISTER = ALU_MNMX_DESTREG;
                                    ALU_MNMX_ACK = COMMIT_EXECUTE_ALU_RESULT_ACK;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}


