    $$ is_adduw =       "EXECUTE_ALU_ALUOP[13,1]"
    $$ is_alt =         "EXECUTE_ALU_ALUOP[12,1]"
    $$ is_bext =        "EXECUTE_ALU_ALUOP[11,1]"
    $$ is_bclr =        "EXECUTE_ALU_ALUOP[11,1]"
    $$ is_rev =         "EXECUTE_ALU_ALUOP[10,1]"
    $$ is_binv =        "EXECUTE_ALU_ALUOP[10,1]"
    $$ is_bset =        "EXECUTE_ALU_ALUOP[ 9,1]"
    $$ is_cond =        "EXECUTE_ALU_ALUOP[ 8,1]"
    $$ is_countsignx =  "EXECUTE_ALU_ALUOP[ 7,1]"
    $$ is_minmax =      "EXECUTE_ALU_ALUOP[ 6,1]"
    $$ is_mul =         "EXECUTE_ALU_ALUOP[ 5,1]"
    $$ is_orcxperm =    "EXECUTE_ALU_ALUOP[ 4,1]"
    $$ is_pack =        "EXECUTE_ALU_ALUOP[ 3,1]"
    $$ is_rotate =      "EXECUTE_ALU_ALUOP[ 2,1]"
    $$ is_shxadd =      "EXECUTE_ALU_ALUOP[ 1,1]"
    $$ is_sra =         "EXECUTE_ALU_ALUOP[ 0,1]"

    $$ ISN          =   "EXECUTE_ALU_INSTRUCTION"
    $$ IS_32        =   "EXECUTE_ALU_INSTRUCTION[3,1]"
    $$ ISN_F3       =   "Rtype( EXECUTE_ALU_INSTRUCTION ).f3"
    $$ ISN_F7       =   "Rtype( EXECUTE_ALU_INSTRUCTION ).f7"
    $$ ISN_CUSTOM   =   "EXECUTE_ALU_CUSTOM"
    $$ ISN_SIGNX    =   "EXECUTE_ALU_SIGNX"
    $$ REG_I1       =   "EXECUTE_ALU_I1"
    $$ REG_I2       =   "EXECUTE_ALU_I2"
    $$ REG_I3       =   "EXECUTE_ALU_I3"
    $$ REG_S1       =   "Rtype( EXECUTE_ALU_INSTRUCTION ).sr1"
    $$ REG_S2       =   "Rtype( EXECUTE_ALU_INSTRUCTION ).sr2"
    $$ REG_RD       =   "Rtype( EXECUTE_ALU_INSTRUCTION ).rd"
    $$ I1I2_LT      =   "EXECUTE_ALU_LT"
    $$ I1I2_LTU     =   "EXECUTE_ALU_LTU"

unit cpu_execute_alu(
    $$for i=1,3 do
    input   uint64              EXECUTE_ALU_I$i$,                                                                                           // INTEGER REGISTERS
    $$end

    output  uint1               EXECUTE_ALU_READY,
    input   uint1               EXECUTE_ALU_ACK,
    input   uint32              EXECUTE_ALU_INSTRUCTION,
    input   uint14              EXECUTE_ALU_ALUOP,
    input   uint1               EXECUTE_ALU_CUSTOM,
    input   uint1               EXECUTE_ALU_SIGNX,
    input   uint1               EXECUTE_ALU_LT,
    input   uint1               EXECUTE_ALU_LTU,

    output  uint1               EXECUTE_ALU_RESULT_READY,
    input   uint1               COMMIT_EXECUTE_ALU_RESULT_ACK,
    output  uint64              COMMIT_ALU_RESULT,
    output  uint5               COMMIT_ALU_REGISTER,

    output  uint32              EXECUTE_ALU_RD                                                                                  // INSTRUCTION IN EXECUTE IS WRITING TO { FLOAT, RD }
) <reginputs> {
    alu_execute EXECUTE( COMMIT_ACK <: COMMIT.ALU_ACK );
    alu_add_execute EXECUTE_ADD( COMMIT_ACK <: COMMIT.ALU_ADD_ACK );
    alu_csx_execute EXECUTE_CSX( COMMIT_ACK <: COMMIT.ALU_CSX_ACK );
    alu_logic_execute EXECUTE_LOGIC( COMMIT_ACK <: COMMIT.ALU_LOGIC_ACK );
    alu_mul_execute EXECUTE_MUL( COMMIT_ACK <: COMMIT.ALU_MUL_ACK );
    alu_cond_execute EXECUTE_COND( COMMIT_ACK <: COMMIT.ALU_COND_ACK );
    alu_mnmx_execute EXECUTE_MNMX( COMMIT_ACK <: COMMIT.ALU_MNMX_ACK );

    alu_commit COMMIT(
        RESULT_READY :> EXECUTE_ALU_RESULT_READY,
        COMMIT_EXECUTE_ALU_RESULT_ACK <: COMMIT_EXECUTE_ALU_RESULT_ACK,
        COMMIT_ALU_RESULT :> COMMIT_ALU_RESULT,
        COMMIT_ALU_REGISTER :> COMMIT_ALU_REGISTER,

        ALU_READY <: EXECUTE.COMMIT_RESULT_READY,
        ALU_RESULT <: EXECUTE.COMMIT_RESULT,
        ALU_DESTREG <: EXECUTE.COMMIT_DESTREG,

        ALU_ADD_READY <: EXECUTE_ADD.COMMIT_RESULT_READY,
        ALU_ADD_RESULT <: EXECUTE_ADD.COMMIT_RESULT,
        ALU_ADD_DESTREG <: EXECUTE_ADD.COMMIT_DESTREG,

        ALU_CSX_READY <: EXECUTE_CSX.COMMIT_RESULT_READY,

        ALU_LOGIC_READY <: EXECUTE_LOGIC.COMMIT_RESULT_READY,

        ALU_MUL_READY <: EXECUTE_MUL.COMMIT_RESULT_READY,
        ALU_MUL_RESULT <: EXECUTE_MUL.COMMIT_RESULT,
        ALU_MUL_DESTREG <: EXECUTE_MUL.COMMIT_DESTREG,

        ALU_COND_READY <: EXECUTE_COND.COMMIT_RESULT_READY,

        ALU_MNMX_READY <: EXECUTE_MNMX.COMMIT_RESULT_READY
    );

    uint1               IS_ADDSUB <:: ~|$ISN_F3$ | $is_shxadd$ ;
    uint1               IS_COUNTSIGNX <:: ( $ISN_F3$ == 3b001 ) & ~$ISN$[5,1] & $is_countsignx$;
    uint1               IS_LOGIC <:: ( ( $ISN_F3$ == 3b100 ) | ( $ISN_F3$ == 3b110 ) | ( $ISN_F3$ == 3b111 ) ) & ( $ISN$[5,1] ? ( $is_alt$ | ~|$ISN_F7$) : 1b1 );
    uint1               IS_SLT <:: ( ( $ISN_F3$ == 3b010 ) | ( $ISN_F3$ == 3b011 ) ) & ( $ISN$[5,1] ? ~|$ISN_F7$ : 1b1 ) & ~$ISN_CUSTOM$;

    uint64              LOGIC_I2 <:: ( $ISN$[5,1] & EXECUTE_ALU_ALUOP[12,1] ) ? ~$REG_I2$ : $REG_I2$;                           // ~I2 FOR ORN ANDN XNOR
    uint1               COND_SR2_N0 <:: |$REG_I2$;                                                                              // $REG_I2$ != 0?

    uint2               MUL_SIGN[4] = { 2b11, 2b11, 2b00, 2b01 };                                                               // SIGN EXTENSION FOR   { MUL MULW, MULH, MULHU, MULHSU }
    int130              MUL <:: ( $ISN_CUSTOM$ ? ( $ISN$[27,1] ? {{49{$REG_I1$[15,1]}}, $REG_I1$[0,16]} :
                                                   $ISN$[26,1] ? {{33{$REG_I1$[31,1]}}, $REG_I1$[0,32]} : { $REG_I1$[63,1], $REG_I1$ } ) :
                                                 ( $IS_32$     ? { 33b0, $REG_I1$[0,32] } : { MUL_SIGN[$ISN_F3$][0,1] & $REG_I1$[63,1], $REG_I1$ } ) )
                                    *
                                                 ( $ISN_CUSTOM$ ? ( $ISN$[27,1] ? {{49{$REG_I2$[15,1]}}, $REG_I2$[0,16]} :
                                                                    $ISN$[26,1] ? {{33{$REG_I2$[31,1]}}, $REG_I2$[0,32]} : { $REG_I2$[63,1], $REG_I2$ } ) :
                                                 ( $IS_32$      ? { 33b0, $REG_I2$[0,32] } : { MUL_SIGN[$ISN_F3$][1,1] & $REG_I2$[63,1], $REG_I2$ } ) );
    uint64              MAC_R <:: ( $ISN$[27,1] | $ISN$[26,1] ) ? ( { {32{MUL[31,1]}}, MUL[0,32] } ) : MUL[0,64];

    EXECUTE.START := 0; EXECUTE_ADD.START := 0; EXECUTE_CSX.START := 0; EXECUTE_LOGIC.START := 0; EXECUTE_MUL.START := 0; EXECUTE_COND.START := 0; EXECUTE_MNMX.START := 0;

    always {
        uint8       STATE = uninitialised;
        uint32      RD = uninitialised;

        uint6       CLZ = uninitialised;
        ( CLZ ) =  clz_silice_64( $ISN_CUSTOM$ ? $ISN$[25,1] ? $REG_I1$ : ~$REG_I1$ : $IS_32$ ? { $REG_I1$[0,32], 32hffffffff } : $REG_I1$ );

        onehot( STATE ) {
            case 0: {
                RD = EXECUTE_ALU_ACK << $REG_RD$;                                                                               // SET / CLEAR THE REGISTER CONTENTION FLAG

                if( EXECUTE_ALU_ACK ) {                                                                                         // WAIT FOR AGU TO ACKNOWLEDGE INSTRUCTION IS READY
                    EXECUTE_ALU_READY = 0;

                    STATE = $is_mul$ ? 4 :
                            $is_minmax$ ? 128 :
                            ( $is_cond$ | IS_SLT ) ? 64 :
                            IS_ADDSUB ? 8 :
                            IS_LOGIC ? 16 :
                            IS_COUNTSIGNX ? 32 :
                            2;
                }
            }
            case 1: {
                if( EXECUTE.READY ) {
                    EXECUTE.INSTRUCTION = $ISN$;
                    EXECUTE.CUSTOM = $ISN_CUSTOM$;
                    EXECUTE.I1 = $REG_I1$;
                    EXECUTE.I2 = $REG_I2$;
                    EXECUTE.ALUOP = EXECUTE_ALU_ALUOP;
                    EXECUTE.SIGNX = $ISN_SIGNX$;

                    EXECUTE.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
            case 2: {
                if( EXECUTE_MUL.READY ) {
                    EXECUTE_MUL.DESTREG = $REG_RD$;
                    EXECUTE_MUL.SIGNX = $ISN_SIGNX$;

                    EXECUTE_MUL.RESULT = $ISN_CUSTOM$ ? $ISN$[25,1] ? ( ( $ISN$[26,1] ? $REG_I3$[0,32] : $REG_I3$ ) - MAC_R ) : // TH.MUL[H|W][S|A]
                                                                      ( ( $ISN$[26,1] ? $REG_I3$[0,32] : $REG_I3$ ) + MAC_R ) :
                                              $IS_32$ ? MUL[ 0, 32 ] : MUL[ { |$ISN_F3$[0,2], 6b0 }, 64 ];

                    EXECUTE_MUL.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
            case 3: {
                if( EXECUTE_ADD.READY ) {
                    EXECUTE_ADD.DESTREG = $REG_RD$;

                    EXECUTE_ADD.RESULT = EXECUTE_ALU_ALUOP[12,1] ? ( ( $IS_32$ ? $REG_I1$[0,32] : $REG_I1$ )                    // SUB[W]
                                                                   -
                                                                     ( $IS_32$ ? $REG_I2$[0,32] : $REG_I2$ ) )
                                                                   :
                                                                   ( ( ( $IS_32$ ? $REG_I1$[0,32] : $REG_I1$ ) << $ISN_F3$[1,2] )
                                                                   +
                                                                     ( $IS_32$ & ~EXECUTE_ALU_ALUOP[13,1] ? $REG_I2$[0,32] : $REG_I2$ ) );
                    EXECUTE_ADD.SIGNX = $ISN_SIGNX$;

                    EXECUTE_ADD.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
            case 4: {
                if( EXECUTE_LOGIC.READY ) {
                    EXECUTE_LOGIC.DESTREG = $REG_RD$;
                    COMMIT.ALU_LOGIC_DESTREG = $REG_RD$;

                    switch( $ISN_F3$[0,2] ) {
                        case 2b00: { COMMIT.ALU_LOGIC_RESULT = $REG_I1$ ^ LOGIC_I2; }                                           // X[N]OR
                        case 2b10: { COMMIT.ALU_LOGIC_RESULT = $REG_I1$ | LOGIC_I2; }                                           // OR[N]
                        default:   { COMMIT.ALU_LOGIC_RESULT = $REG_I1$ & LOGIC_I2; }                                           // AND[N]
                    }

                    EXECUTE_LOGIC.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
            case 5: {
                if( EXECUTE_CSX.READY ) {
                    EXECUTE_CSX.DESTREG = $REG_RD$;
                    COMMIT.ALU_CSX_DESTREG = $REG_RD$;

                    if( $ISN_CUSTOM$ ) {
                        COMMIT.ALU_CSX_RESULT = ( $ISN$[25,1] ? ~|$REG_I1$ : &$REG_I1$ ) ? 64 : ~CLZ;                           // TH.FF1 TH.FF0
                    } else {
                        if( ~$REG_S2$[2,1] ) {                                                                                  // CLZ[W] CTZ[W] CPOP[W]
                            if( ( ~$IS_32$ & |$REG_I1$ ) | ( $IS_32$ & |$REG_I1$[0,32] ) ) {                                    // CHECK FOR SPECIAL CASES
                                switch( $REG_S2$[0,2] ) {
                                    case 2b00: { COMMIT.ALU_CSX_RESULT = CLZ; }
                                    case 2b01: { ( COMMIT.ALU_CSX_RESULT ) =  ctz_silice_64( $IS_32$ ? { 32hffffffff, $REG_I1$[0,32] } : $REG_I1$ ); }
                                    default:   { ( COMMIT.ALU_CSX_RESULT ) = cpop_silice_64( $IS_32$ ?                $REG_I1$[0,32] :   $REG_I1$ ); }
                                }
                            } else {
                                COMMIT.ALU_CSX_RESULT = { ~$IS_32$ & ~$REG_S2$[1,1], $IS_32$ & ~$REG_S2$[1,1], 5b00000 };       // REPORT 32/64 FOR CTZ/CLZ AND 0 FOR CPOP IF SOURCEREG1 == 0
                            }
                        } else {
                            COMMIT.ALU_CSX_RESULT = $REG_S2$[0,1] ? { {48{$REG_I1$[15,1]}}, $REG_I1$[0,16] } :                  // SEXT.H
                                                                    { {56{$REG_I1$[ 7,1]}}, $REG_I1$[0, 8] };                   // SEXT.B
                        }
                    }

                    EXECUTE_CSX.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
            case 6: {
                if( EXECUTE_COND.READY ) {
                    EXECUTE_COND.DESTREG = $REG_RD$;
                    COMMIT.ALU_COND_DESTREG = $REG_RD$;

                    if( $ISN_CUSTOM$ ) {
                        COMMIT.ALU_COND_RESULT = ( $ISN$[25,1] ? COND_SR2_N0 : ~COND_SR2_N0 ) ? $REG_I1$ : $REG_I3$;           // TH.MVEQZ TH.MVNEZ
                    } else {
                        switch( $ISN_F3$ ) {
                            case 3b010: { COMMIT.ALU_COND_RESULT = $I1I2_LT$; }                                                     // SLT[I]
                            case 3b011: {
                                COMMIT.ALU_COND_RESULT = $ISN$[5,1] ? ( ~|$REG_S1$ ) ? COND_SR2_N0 : $I1I2_LTU$ :                   // SLTU  ( RS1==x0 ? op2!=0 : op1<op2 )
                                                                    ( $REG_I2$ == 1 ) ? ~|$REG_I1$ : $I1I2_LTU$;                  // SLTIU ( op2==1  ? RS1==0 : op1<op2 )
                            }
                            default: { COMMIT.ALU_COND_RESULT = ( $ISN_F3$[1,1] ? COND_SR2_N0 : ~COND_SR2_N0 ) ? 0 : $REG_I1$; }                  // CZERO.EQZ CZERO.NEZ
                        }
                    }

                    EXECUTE_COND.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
            case 7: {
                if( EXECUTE_MNMX.READY ) {
                    EXECUTE_MNMX.DESTREG = $REG_RD$;
                    COMMIT.ALU_MNMX_DESTREG = $REG_RD$;

                    COMMIT.ALU_MNMX_RESULT = ( ( $ISN_F3$[0,1] ? $I1I2_LTU$ : $I1I2_LT$ ) ^ $ISN_F3$[1,1] ) ? $REG_I1$ :        // MIN[U] MAX[U]
                                                                                                              $REG_I2$;

                    EXECUTE_MNMX.START = 1; EXECUTE_ALU_READY = 1; STATE = 1;
                }
            }
        }

        EXECUTE_ALU_RD = RD | EXECUTE.RD | EXECUTE_ADD.RD | EXECUTE_CSX.RD | EXECUTE_LOGIC.RD | EXECUTE_MUL.RD | EXECUTE_COND.RD | EXECUTE_MNMX.RD | COMMIT.RD;

        if( reset ) {
            RD = 0; EXECUTE_ALU_READY = 1; STATE = 1;
            EXECUTE.START = 0; EXECUTE_ADD.START = 0; EXECUTE_CSX.START = 0; EXECUTE_LOGIC.START = 0; EXECUTE_MUL.START = 0; EXECUTE_COND.START = 0; EXECUTE_MNMX.START = 0;
        }
    }
}

// ALU - ALU for immediate-register operations and register-register operations
    $$ doadduw =        "ALUOP[13,1]"
    $$ doalt =          "ALUOP[12,1]"
    $$ dobext =         "ALUOP[11,1]"
    $$ dobclr =         "ALUOP[11,1]"
    $$ dorev =          "ALUOP[10,1]"
    $$ dobinv =         "ALUOP[10,1]"
    $$ dobset =         "ALUOP[ 9,1]"
    $$ docond =         "ALUOP[ 8,1]"
    $$ docountsignx =   "ALUOP[ 7,1]"
    $$ dominmax =       "ALUOP[ 6,1]"
    $$ domul =          "ALUOP[ 5,1]"
    $$ doorcxperm =     "ALUOP[ 4,1]"
    $$ dopack =         "ALUOP[ 3,1]"
    $$ dorotate =       "ALUOP[ 2,1]"
    $$ doshxadd =       "ALUOP[ 1,1]"
    $$ dosra =          "ALUOP[ 0,1]"

unit alu_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,

    input   uint32              INSTRUCTION,
    input   uint1               CUSTOM,
    input   uint64              I1,
    input   uint64              I2,
    input   uint14              ALUOP,
    input   uint1               SIGNX,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG
) <reginputs> {
    uint3               STATE = 1;

    uint6   SHIFT <::           CUSTOM ? ( 63 - INSTRUCTION[26,6] ) :                                                                   // SHIFT FOR th.ext[u] ( to align left )
                      INSTRUCTION[5,1] ? ( INSTRUCTION[3,1] ? I2[0,5] : I2[0,6] ) :                                             // EXTRACT SHIFT COUNT FOR SHIFTS AND ROTATES
                                         { ~INSTRUCTION[3,1] & Rtype( INSTRUCTION ).f7[0,1], Rtype( INSTRUCTION ).sr2 };
    uint7   R_SHIFT <:: CUSTOM ? ( ( { 1b0, INSTRUCTION[20,6] } + { 1b0, SHIFT } ) ) :                                          // SHIFT FOR th.ext[u] ( to align right )
                                 ( { ~INSTRUCTION[3,1], INSTRUCTION[3,1], 5b00000 } - SHIFT );                                  // SHIFT FOR ROTATE
    uint64  SLL <:: ( CUSTOM ? I1 : INSTRUCTION[3,1] ? I1[0,32] : I1 ) << ( CUSTOM ? SHIFT : $dorotate$ ? Rtype( INSTRUCTION ).f3[2,1] ? R_SHIFT : SHIFT : SHIFT );
    uint64  SRL <:: ( CUSTOM ? SLL : INSTRUCTION[3,1] ? I1[0,32] : I1 ) >> ( CUSTOM ? R_SHIFT : $dorotate$ ? Rtype( INSTRUCTION ).f3[2,1] ? SHIFT : R_SHIFT : SHIFT );
    uint64  SRA <:: __signed( CUSTOM ? SLL : { INSTRUCTION[3,1] ? {32{I1[31,1]}} : I1[32,32], I1[0,32] } ) >>> ( CUSTOM ? R_SHIFT : SHIFT );
    uint64  ROTATE <:: ( SLL | SRL );                                                                                           // MAKE ROTATE FROM SHIFTS

    uint64  ORCB <:: {                                                                                                          // ORC.B
                $$for i=0,6 do
                {8{|I1[$(7-i)*8$,8]}},
                $$end
                {8{|I1[        0,8]}}
              };
    uint64  REV <:: ( CUSTOM | Rtype( INSTRUCTION ).f7[0,1] ) ? {                                                                            // REV8
                            I1[ 0,8], I1[ 8,8],
                            I1[16,8], I1[24,8],
                            I1[32,8], I1[40,8],
                            I1[48,8], I1[56,8]
                       } :
                       {                                                                                                        // REV.B
                            $$for i=0,6 do
                            $$for j=0,7 do
                            I1[$(7-i)*8+j$,1],
                            $$end
                            $$end
                            $$for j=0,6 do
                            I1[$j$,1],
                            $$end
                            I1[7,1]
                       };

    COMMIT_RESULT_READY := STATE[2,1];

    always {
        uint64  MASK = uninitialised;

        onehot( STATE ) {
            case 0: {
                if( START ) {
                    READY = 0; STATE = 2; RD[ Rtype( INSTRUCTION ).rd, 1 ] = 1; MASK[ SHIFT,1 ] = 1;
                }
            }
            case 1: {
                COMMIT_DESTREG = Rtype( INSTRUCTION ).rd;
                if( CUSTOM ) {
                    COMMIT_RESULT = $doorcxperm$ ? ~ORCB : $dorev$ ? REV[32,32] : Rtype( INSTRUCTION ).f3[0,1] ? SRL : SRA;
                } else {
                    switch( Rtype( INSTRUCTION ).f3 ) {
                        case 3b001: {
                            COMMIT_RESULT = $dobclr$ ? ( I1 & ~MASK ) :                                                           // BCLR
                                            $dobinv$ ? ( I1 ^  MASK ) :                                                           // BINV
                                            $dobset$ ? ( I1 |  MASK ) :                                                           // BSET
                                            $dorotate$ ? { SIGNX ? {32{ROTATE[31,1]}} : ROTATE[32,32], ROTATE[0, 32] } :            // ROL[W]
                                                        { SIGNX ? {32{SLL[31,1]}} : SLL[32,32], SLL[0, 32] };                      // SLL[W]
                        }
                        case 3b010: {
                            COMMIT_RESULT = {                                                                          // XPERMN
                                $$for i=0,14 do
                                I1[ { I2[$(16-i)*4-4$,4], 2b00 }, 4 ],
                                $$end
                                I1[ {            I2[0,4], 2b00 }, 4 ]
                        };
                        }
                        case 3b100: {
                            COMMIT_RESULT = $dopack$ ? INSTRUCTION[3,1] ? { {32{I2[15,1]}}, I2[0,16], I1[0,16] } :              // PACKW ( low 16 bits of RS1 RS2 into rd )
                                {                  I2[0,32], I1[0,32] } :                                                        // PACK  ( low 32 bits of RS1 RS2 into rd, ZEXT.H when Rtype( INSTRUCTION ).sr2 == 0 )                                                                        // PACKW PACK
                                                    {                                                                                                       // XPERMB
                                $$for i=0,6 do
                                I2[ $(8-i)*8-1$,1 ] ? 8h0 : I1[ { I2[ $(8-i)*8-4$, 3 ], 3b000 }, 8 ],
                                $$end
                                I2[           7,1 ] ? 8h0 : I1[ {           I2[ 0, 3 ], 3b000 }, 8 ]
                        };
                        }
                        case 3b101: {
                            COMMIT_RESULT = $doorcxperm$ ? ORCB :                                                                   // ORC.B
                                                $dorev$ ? REV :                                                                    // REV8 REV.B
                                                $dobext$ ? I1[ SHIFT, 1 ] :                                                         // BEXT
                                            $dorotate$ ? { SIGNX ? {32{ROTATE[31,1]}} : ROTATE[32,32], ROTATE[0, 32] } :          // ROR[W]
                                                $dosra$ ? { SIGNX ? {32{SRA[31,1]}} : SRA[32,32], SRA[0, 32] } :                   // SRA[W]
                                                        { SIGNX ? {32{SRL[31,1]}} : SRL[32,32], SRL[0, 32] };                    // SRL[W]
                        }
                        default: {
                            COMMIT_RESULT = {            48b0, I2[0, 8], I1[0, 8] };                                                                                   // PACKH
                        }
                    }
                }
                STATE = 4;
            }
            case 2: { if( COMMIT_ACK ) { RD = 0; READY = 1; MASK = 0; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; MASK = 0; STATE = 1; }
    }
}

unit alu_add_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,

    input   uint64              RESULT,
    input   uint5               DESTREG,
    input   uint1               SIGNX,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG
) <reginputs> {
    uint3               STATE = 1;

    COMMIT_DESTREG := DESTREG;
    COMMIT_RESULT := { SIGNX ? {32{RESULT[31, 1]}} : RESULT[32,32], RESULT[0, 32] };
    COMMIT_RESULT_READY := STATE[2,1];

    always {
        onehot( STATE ) {
            case 0: { if( START ) { READY = 0; STATE = 2; RD[ DESTREG, 1 ] = 1; } }
            case 1: { STATE = 4; }
            case 2: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit alu_cond_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,

    input   uint5               DESTREG,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint5               COMMIT_DESTREG
) <reginputs> {
    uint3               STATE = 1;

    COMMIT_DESTREG := DESTREG;
    COMMIT_RESULT_READY := STATE[2,1];

    always {
        onehot( STATE ) {
            case 0: { if( START ) { READY = 0; STATE = 2; RD[ DESTREG, 1 ] = 1; } }
            case 1: { STATE = 4; }
            case 2: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

