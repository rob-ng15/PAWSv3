// CPU MEMORY BUS CONTROLLER
// INTERFACE 64-BIT CPU BUS TO 32-BIT MEMORY BUS
// HANDLE ARBITRATION WITH THE BUS CONTROLLER
// HANDLE ARBITRATION BETWEEN FETCH, STORE AND LOAD
// HANDLE MISALIGNED LOAD/STORE

unit cpu_memory(
    input   uint1               clock_cache,                                                                                    // CLOCKS TO PASS TO CPU
    input   uint1               clock_decode,
    output  uint8               DEBUG,

    output  uint$addr_width$    MEM_ADDR,                                                                                       // MEMORY INTERFACE LINES
    output  uint2               MEM_SIZE,
    output  uint32              MEM_WDATA,
    output  uint1               MEM_WENABLE,
    input   uint32              MEM_RDATA,
    output  uint1               MEM_RENABLE,
    input   uint1               MEM_BUSY,
    input   uint1               MEM_ACK,

    input   uint1               DMA_ACTIVE,                                                                                     // DMA AUDIO/COPY/SET IS ACTIVE

    input   uint$CWIDTH$        RDTIME,                                                                                         // MAIN SYSTEM TICK
    input   uint$CWIDTH$        IRQ_TIMER,                                                                                      // IRQ TIMER TRIGGER VALUE
    input   uint1               TIMER_VALID,                                                                                    // HAS IRQ TIMER TRIGGER VALUE BEEN FULLY SET
    input   uint1               IRQ_VBLANK                                                                                      // IRQ VBLANK
) <reginputs> {
    uint9               STATE = uninitialised;
                        $$ STATE_FLS_WAIT = 1
                        $$ STATE_WAIT_ACK = 2
                        $$ STATE_STORE_FINISH = 4
                        $$ STATE_STORE_64BIT = 8
                        $$ STATE_LOAD = 16
                        $$ STATE_LOAD_64BIT = 32
                        $$ STATE_FETCH = 64
                        $$ STATE_LOAD_MA = 128
                        $$ STATE_STORE_MA = 256
    uint9               NEXT_STATE = uninitialised;

    uint4               COUNT = uninitialised;
    uint4               COUNT_NEXT <:: COUNT + 1;
    uint1               COUNT_MORE <:: ( COUNT_NEXT != ( STATE[8,1] ? MAX_STORE : MAX_LOAD ) );
    uint4               MAX_LOAD <:: CPU.MEM_SIZE_LOAD[1,1] ? ( CPU.MEM_SIZE_LOAD[0,1] ? 4d4 : 4d3 ) : 4d2;                       // 2 (16b), 3 (32b), 4 (64b) BEATS
    uint4               MAX_STORE <:: CPU.MEM_SIZE_STORE[1,1] ? ( CPU.MEM_SIZE_STORE[0,1] ? 4d4 : 4d3 ) : 4d2;                    // 2 (16b), 3 (32b), 4 (64b) BEATS

    uint1               IS_MA = uninitialised;                                                                                  // MIS-ALIGNED FLAG
    uint1               IS_LOAD_MA <:: ( |CPU.MEM_SIZE_LOAD & CPU.MEM_ADDR_LOAD[0,1] );
    uint1               IS_STORE_MA <:: ( |CPU.MEM_SIZE_STORE & CPU.MEM_ADDR_STORE[0,1] );

    uint1               IS_LOAD_64 <:: &CPU.MEM_SIZE_LOAD;
    uint1               IS_STORE_64 <:: &CPU.MEM_SIZE_STORE;
    uint$addr_width$    NEXT_MEM_ADDR <:: MEM_ADDR + ( IS_MA ? ( 1 << COUNT[0,2] ) : 4 );                                         // NEXT ADDRESS (+1/+2/+4 MA, +4 64-BIT)

    cpu CPU(
        clock_cache <: clock_cache, clock_decode <: clock_decode,
        DMA_ACTIVE <:DMA_ACTIVE,

        IRQ_TIMER <: IRQ_TIMER,
        TIMER_VALID <: TIMER_VALID,
        RDTIME <: RDTIME,
        IRQ_VBLANK <: IRQ_VBLANK
    );

    CPU.MEM_ACK_FETCH := 0;
    CPU.MEM_ACK_LOAD := 0;
    CPU.MEM_ACK_STORE := 0;

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_FLS_WAIT
                COUNT = 0;

                if( CPU.MEM_REQ_STORE ) {                                                                                       //  IF STORE REQUEST
                    CPU.MEM_ACK_STORE = 1; CPU.MEM_BUSY_STORE = 1;                                                              //      ACKNOWLEDGE STORE REQUEST
                    MEM_ADDR = CPU.MEM_ADDR_STORE;                                                                              //      SET STORE ADDRESS
                    MEM_WDATA = CPU.MEM_WDATA[0,32];
                    MEM_SIZE = IS_STORE_MA ? 2b00 : CPU.MEM_SIZE_STORE[1,1] ? 2b10 : CPU.MEM_SIZE_STORE;
                    IS_MA = IS_STORE_MA; MEM_WENABLE = 1;                                                                       //  START WRITE TO MEMORY
                    NEXT_STATE = IS_STORE_MA ? $STATE_STORE_MA$ : IS_STORE_64 ? $STATE_STORE_64BIT$ : $STATE_STORE_FINISH$;     //          NEXT IS MA, 64 OR 8/16/32 BIT STORE
                    STATE = $STATE_WAIT_ACK$;                                                                                   //  GO TO STATE_STORE_WAIT_ACK
                } else {
                    if( CPU.MEM_REQ_LOAD ) {                                                                                    //  IF LOAD REQUEST
                        CPU.MEM_ACK_LOAD = 1; CPU.MEM_BUSY_LOAD = 1; CPU.MEM_RDATA = 0;                                         //      ACKNOWLEDGE LOAD REQUEST, RESET CPU.MEM_RDATA
                        MEM_ADDR = CPU.MEM_ADDR_LOAD;                                                                           //      SET LOAD ADDRESS
                        MEM_SIZE = IS_LOAD_MA ? 2b00 : CPU.MEM_SIZE_LOAD[1,1] ? 2b10 : CPU.MEM_SIZE_LOAD;
                        IS_MA = IS_LOAD_MA; MEM_RENABLE = 1;                                                                    //  START READ FROM MEMORY
                        NEXT_STATE = IS_LOAD_MA ? $STATE_LOAD_MA$ : $STATE_LOAD$;                                               //          NEXT IS MA OR 8/16/32/64 BIT LOAD
                        STATE = $STATE_WAIT_ACK$;                                                                               //  GO TO STATE_WAIT_ACK
                    } else {
                        if( CPU.MEM_REQ_FETCH ) {                                                                               //  IF FETCH REQUEST
                            CPU.MEM_ACK_FETCH = 1; CPU.MEM_BUSY_FETCH = 1;                                                      //      ACKNOWLEDGE FETCH REQUEST
                            MEM_ADDR = CPU.MEM_ADDR_PC; MEM_SIZE = 2b10;                                                        //      SET PC ADDRESS AND 32 BIT READ
                            NEXT_STATE = $STATE_FETCH$;                                                                         //      NEXT IS STATE_FETCH
                            MEM_RENABLE = 1;                                                                                    //      START READ FROM MEMORY
                            STATE = $STATE_WAIT_ACK$;                                                                           //      GO TO STATE_WAIT_ACK
                        }
                    }
                }
            }

            case 1: { if( MEM_ACK ) { MEM_RENABLE = 0; MEM_WENABLE = 0; STATE = NEXT_STATE; } }                                 //  STATE_WAIT_ACK

            case 2: { if( ~MEM_BUSY ) { CPU.MEM_BUSY_STORE = 0; STATE = $STATE_FLS_WAIT$; } }                                   //  STATE_STORE_FINISH
            case 3: {                                                                                                           //  STATE_STORE_64BIT
                if( ~MEM_BUSY ) {
                    MEM_ADDR = NEXT_MEM_ADDR; MEM_WDATA = CPU.MEM_WDATA[32,32]; MEM_WENABLE = 1;
                    NEXT_STATE = $STATE_STORE_FINISH$; STATE = $STATE_WAIT_ACK$;
                }
            }

            case 4: {                                                                                                           //  STATE_LOAD
                if( ~MEM_BUSY ) {                                                                                               //      IF ~MEM_BUSY
                    switch( CPU.MEM_SIZE_LOAD ) {                                                                               //          COPY DATA
                        case 2b00: { CPU.MEM_RDATA = MEM_RDATA[ { CPU.MEM_ADDR_LOAD[0,1], 3b000 },  8 ]; }                      //              8 BIT
                        case 2b01: { CPU.MEM_RDATA = MEM_RDATA[                                 0, 16 ]; }                      //              16 BIT
                        default:   { CPU.MEM_RDATA[0,32] = MEM_RDATA; }                                                         //              32/64 BIT
                    }
                    if( IS_LOAD_64 ) {                                                                                          //          IF 64BIT
                        MEM_ADDR = NEXT_MEM_ADDR; MEM_RENABLE = 1;                                                              //              SET NEXT ADDRESS AND START READ
                        NEXT_STATE = $STATE_LOAD_64BIT$;                                                                        //              NEXT STATE_LOAD_64BIT
                        STATE = $STATE_WAIT_ACK$;                                                                               //              GO TO STATE_WAIT_ACK
                    } else {                                                                                                    //          ELSE
                        CPU.MEM_BUSY_LOAD = 0;                                                                                  //              SIGNAL COMPLETE
                        STATE = $STATE_FLS_WAIT$;                                                                               //              RETURN TO WAIT
                    }
                }
            }
            case 5: {                                                                                                           //  STATE_LOAD_64BIT
                if( ~MEM_BUSY ) {                                                                                               //      IF ~MEM_BUSY
                    CPU.MEM_RDATA[32,32] = MEM_RDATA;                                                                           //          COPY DATA
                    CPU.MEM_BUSY_LOAD = 0;                                                                                      //          SIGNAL COMPLETE
                    STATE = $STATE_FLS_WAIT$;                                                                                   //          RETURN TO WAIT
                }
            }

            case 6: {                                                                                                           //  STATE_FETCH
                if( ~MEM_BUSY ) {                                                                                               //      IF ~MEM_BUSY
                    CPU.MEM_INSTRUCTION = MEM_RDATA;                                                                            //          COPY DATA
                    CPU.MEM_BUSY_FETCH = 0;                                                                                     //          SIGNAL COMPLETE
                    STATE = $STATE_FLS_WAIT$;                                                                                   //          RETURN TO WAIT
                }
            }

            case 7: {                                                                                                           //  STATE_LOAD_MA
                if( ~MEM_BUSY ) {                                                                                               //      IF ~MEM_BUSY
                    switch( COUNT[0,2] ) {
                        case 2b00: { CPU.MEM_RDATA[ 0, 8] = MEM_RDATA[8, 8]; }                                                  //          BYTE 0 (odd addr -> upper byte lane)
                        case 2b01: {                                                                                            //          BYTE 1 (16b) OR BYTES 1..2 (32b/64b)
                            if( CPU.MEM_SIZE_LOAD[1,1] ) { CPU.MEM_RDATA[8,16] = MEM_RDATA[0,16]; }
                            else                         { CPU.MEM_RDATA[8, 8] = MEM_RDATA[0, 8]; }
                        }
                        case 2b10: {                                                                                            //          BYTE 3 (32b) OR BYTES 3..6 (64b)
                            if( CPU.MEM_SIZE_LOAD[0,1] ) { CPU.MEM_RDATA[24,32] = MEM_RDATA[0,32]; }
                            else                         { CPU.MEM_RDATA[24, 8] = MEM_RDATA[0, 8]; }
                        }
                        case 2b11: { CPU.MEM_RDATA[56, 8] = MEM_RDATA[0, 8]; }                                                  //          BYTE 7 (64b)
                    }
                    if( COUNT_MORE ) {                                                                                          //          IF NOT FINISHED
                        MEM_ADDR = NEXT_MEM_ADDR;
                        MEM_SIZE = ( COUNT[0,2] == 2b00 ) ? { 1b0, CPU.MEM_SIZE_LOAD[1,1] } :                                   //              BEAT 1: 8b (16b load) OR 16b (32b/64b load)
                        ( COUNT[0,2] == 2b01 ) ? { CPU.MEM_SIZE_LOAD[0,1], 1b0 } :                                              //              BEAT 2: 8b (32b load) OR 32b (64b load)
                        2b00;                                                                                                   //              BEAT 3: 8b (64b load)
                        MEM_RENABLE = 1;
                        COUNT = COUNT_NEXT; STATE = $STATE_WAIT_ACK$;
                    } else {                                                                                                    //          ELSE
                        CPU.MEM_BUSY_LOAD = 0;                                                                                  //              SIGNAL COMPLETE
                        STATE = $STATE_FLS_WAIT$;                                                                               //              RETURN TO WAIT
                    }
                }
            }

            case 8: {                                                                                                           //  STATE_STORE_MA
                if( ~MEM_BUSY ) {                                                                                               //      IF ~MEM_BUSY
                    if( COUNT_MORE ) {                                                                                          //          IF NOT FINISHED
                        MEM_ADDR = NEXT_MEM_ADDR;
                        switch( COUNT[0,2] ) {
                            case 2b00: {                                                                                        //              BEAT 1: 8b (16b store) OR 16b (32b/64b store)
                                MEM_SIZE  = { 1b0, CPU.MEM_SIZE_STORE[1,1] };
                                MEM_WDATA = { 16b0, CPU.MEM_WDATA[8,16] };
                            }
                            case 2b01: {                                                                                        //              BEAT 2: 8b (32b store) OR 32b (64b store)
                                MEM_SIZE  = { CPU.MEM_SIZE_STORE[0,1], 1b0 };
                                MEM_WDATA = CPU.MEM_WDATA[24,32];
                            }
                            default: {                                                                                          //              BEAT 3: 8b (64b store)
                                MEM_SIZE  = 2b00;
                                MEM_WDATA = { 24b0, CPU.MEM_WDATA[56,8] };
                            }
                        }
                        MEM_WENABLE = 1;
                        COUNT = COUNT_NEXT; STATE = $STATE_WAIT_ACK$;
                    } else {                                                                                                    //          ELSE
                        CPU.MEM_BUSY_STORE = 0;                                                                                 //              SIGNAL COMPLETE
                        STATE = $STATE_FLS_WAIT$;                                                                               //              RETURN TO WAIT
                    }
                }
            }
        }

        if( reset ) { CPU.MEM_BUSY_FETCH = 0; CPU.MEM_BUSY_LOAD = 0; CPU.MEM_BUSY_STORE = 0; STATE = $STATE_FLS_WAIT$; }        // IF RESET CANCEL BUSY FLAGS AND GO TO STATE_FLS_WAIT
    }
}
