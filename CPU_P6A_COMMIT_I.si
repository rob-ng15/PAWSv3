// CPU PIPELINE STAGE 6A - COMMIT_I
// CONTROL THE WRITING OF EXECUTION RESULTS TO INTEGER REGISTERS
// CAN COMMIT ONE INSTRUCTION PER CYCLE
// POLLS EXECUTION STAGE UNITS IN ORDER OF PRIORITY
//  LSA-FASTBASE-ALU-CSRFFPU-DIVIDE

unit cpu_commit_i(
    $$for i=1,3 do
    simple_dualport_bram_port1 I$i$,                                                                                            // INTEGER REGISTERS WRITE PORT
    $$end

    input   uint1               EXECUTE_ALU_RESULT_READY,
    output  uint1               COMMIT_EXECUTE_ALU_RESULT_ACK,
    input   uint64              COMMIT_ALU_RESULT,                                                                              // FAST ALU EXECUTE RESULT
    input   uint5               COMMIT_ALU_REGISTER,                                                                            // FAST ALU EXECUTE RESULT REGISTER

    input   uint1               EXECUTE_LSA_RESULT_READY,
    output  uint1               COMMIT_EXECUTE_LSA_RESULT_ACK,
    input   uint64              COMMIT_LSA_RESULT,                                                                              // FAST LSA EXECUTE RESULT
    input   uint5               COMMIT_LSA_REGISTER,                                                                            // FAST LSA EXECUTE RESULT REGISTER

    input   uint1               EXECUTE_CSRFPU_RESULT_READY,
    output  uint1               COMMIT_EXECUTE_CSRFPU_RESULT_ACK,
    input   uint64              COMMIT_CSRFPU_RESULT,                                                                           // CSR AND FPU EXECUTE RESULT
    input   uint5               COMMIT_CSRFPU_REGISTER,                                                                         // CSR AND FPU EXECUTE RESULT REGISTER


    input   uint1               EXECUTE_ALUDIVIDE_RESULT_READY,
    output  uint1               COMMIT_EXECUTE_ALUDIVIDE_RESULT_ACK,
    input   uint64              COMMIT_ALUDIVIDE_RESULT,                                                                        // ALU DIVISION EXECUTE RESULT
    input   uint5               COMMIT_ALUDIVIDE_REGISTER,                                                                      // ALU DIVISION EXECUTE RESULT REGISTER

    input   uint1               EXECUTE_FASTBASE_RESULT_READY,
    output  uint1               COMMIT_EXECUTE_FASTBASE_RESULT_ACK,
    input   uint64              COMMIT_FASTBASE_RESULT,                                                                           // CSR AND FPU EXECUTE RESULT
    input   uint5               COMMIT_FASTBASE_REGISTER,                                                                         // CSR AND FPU EXECUTE RESULT REGISTER

    output  uint32              COMMIT_RD                                                                                       // INSTRUCTION COMMIT IS WRITING TO { FLOAT, RD }
) <reginputs> {
    uint5   ADDR <: EXECUTE_FASTBASE_RESULT_READY ? COMMIT_FASTBASE_REGISTER :
                    EXECUTE_ALU_RESULT_READY ? COMMIT_ALU_REGISTER :
                    EXECUTE_CSRFPU_RESULT_READY ? COMMIT_CSRFPU_REGISTER :
                    EXECUTE_LSA_RESULT_READY ? COMMIT_LSA_REGISTER :
                    EXECUTE_ALUDIVIDE_RESULT_READY ? COMMIT_ALUDIVIDE_REGISTER :
                    0;
    uint1   WENABLE <: |ADDR;
    uint64  WDATA <: EXECUTE_FASTBASE_RESULT_READY ? COMMIT_FASTBASE_RESULT :
                    EXECUTE_ALU_RESULT_READY ? COMMIT_ALU_RESULT :
                    EXECUTE_CSRFPU_RESULT_READY ? COMMIT_CSRFPU_RESULT :
                    EXECUTE_LSA_RESULT_READY ? COMMIT_LSA_RESULT :
                    COMMIT_ALUDIVIDE_RESULT;

    $$for i=1,3 do
    I$i$.wenable1 := WENABLE;
    I$i$.addr1 := ADDR;
    I$i$.wdata1 := WDATA;
    $$end

    COMMIT_EXECUTE_ALU_RESULT_ACK := 0;
    COMMIT_EXECUTE_ALUDIVIDE_RESULT_ACK := 0;
    COMMIT_EXECUTE_CSRFPU_RESULT_ACK := 0;
    COMMIT_EXECUTE_FASTBASE_RESULT_ACK := 0;
    COMMIT_EXECUTE_LSA_RESULT_ACK := 0;

    always {                                                                                                                    // ACCEPT RESULT AND COMMIT FROM EXECUTE STAGES
        COMMIT_RD = WENABLE << ADDR;

        if( EXECUTE_FASTBASE_RESULT_READY ) {
            COMMIT_EXECUTE_FASTBASE_RESULT_ACK = 1;
        } else {
            if( EXECUTE_ALU_RESULT_READY ) {
                COMMIT_EXECUTE_ALU_RESULT_ACK = 1;
            } else {
                if( EXECUTE_CSRFPU_RESULT_READY  ) {
                    COMMIT_EXECUTE_CSRFPU_RESULT_ACK = 1;
                } else {
                    if( EXECUTE_LSA_RESULT_READY ) {
                        COMMIT_EXECUTE_LSA_RESULT_ACK = 1;
                    } else {
                        COMMIT_EXECUTE_ALUDIVIDE_RESULT_ACK = EXECUTE_ALUDIVIDE_RESULT_READY;
                    }
                }
            }
        }
    }
}
