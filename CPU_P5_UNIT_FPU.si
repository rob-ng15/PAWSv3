// of this software and associated documentation files (the "Software"), to deal
// in the Software without restriction, including without limitation the rights
// to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
// copies of the Software, and to permit persons to whom the Software is
// furnished to do so, subject to the following conditions:
//
// The above copyright notice and this permission notice shall be included in all
// copies or substantial portions of the Software.
//
// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
// IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
// AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
// LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
// OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
// SOFTWARE.
//
unit prep_float_sqrt(
    input   uint10  BIAS,                                                                                                       // BIAS FOR DOUBLE/SINGLE/HALF
    input   uint64  a,                                                                                                          // A INPUT FOR SQRT(A)
    output  uint1   expODD,
    output  int13   squarerootexp,
    output  uint108 START_ac,
    output  uint106 START_x
) <reginputs> {
    int13               expA <:: fp64( a ).exponent - BIAS;                                                                     // EXTRACT EXPONENT AND REMOVE BIAS

    squarerootexp := expA >>> 1;                                                                                                // RESULT EXPONENT IS HALF OF INPUT EXPONENT
    START_ac := expA[0,1] ? { 106b0, 1b1, a[ 51, 1 ] } : 1;                                                                     // STARTING ACCUMULATOR ( depends if exp is odd / even )
    START_x := expA[0,1] ? { a[0,51], 55b0 } : { fp64( a ).fraction, 54b0 };                                                    // STARTING FRACTION ( depends if exp is odd / even )
    expODD := expA[0,1];                                                                                                        // IS EXP ODD, RETURN SQRT(2) OR 1 FOR POWER OF 2 SQUAREROOTS
}
unit do_float_sqrt(
    input   uint1   START,
    output  uint1   BUSY,
    input   uint6   SB,
    input   uint1   powTWO,
    input   uint1   expODD,
    input   uint108 START_ac,
    input   uint106 START_x,
    output  uint54  squareroot
) <reginputs> {
    uint108             ac = uninitialised;
    uint106             x = uninitialised;
    uint108             test_res <:: ac - { squareroot, 2b01 };
    uint6               i = uninitialised;
    uint6               iNEXT <:: i - 1;
    uint1               FINISHED <:: &i;

    uint2               STATE = 1;
                        $$ STATE_FPU_SQRT_WAIT  = 1
                        $$ STATE_FPU_SQRT       = 2

    always {
        onehot( STATE ) {
            case 0: {
                BUSY = START & ~powTWO;
                if( START ) {
                    if( powTWO ) {
                        squareroot = expODD ? 54h2D413CCCFE7799 : 1;                                                            // DETECT POWER OF 2, RETURN ROOT 2 / 1 IF EXP ODD / EVEN
                    } else {
                        i = SB; squareroot = 0; ac = START_ac; x = START_x;                                                     // SELECT STARTING BIT ( counter for number of bits to process )
                        STATE = $STATE_FPU_SQRT$;
                    }
                }
            }
            case 1: {
                if( FINISHED ) {
                    BUSY = 0; STATE = $STATE_FPU_SQRT_WAIT$;
                } else {
                    ac = { test_res[107,1] ? ac[0,105] : test_res[0,105], x[104,2] };                                           // FIND NEW ACCUMULATOR
                    squareroot = { squareroot[0,53], ~test_res[107,1] };                                                        // ADD NEXT BIT TO SQUAREROOT ( shift in from right )
                    x = { x[0,104], 2b00 };                                                                                     // MOVE 2 PLACES ALONG REMAINING FRACTION
                    i = iNEXT;                                                                                                  // MOVE TO NEXT BIT
                }
            }
        }
    }
}
// CASCADED/UNROLLED FLOATING POINT SQUARE ROOT (2 bits per cycle)
unit do_float_sqrt_radix4(
    input   uint1   START,
    output  uint1   BUSY(0),
    input   uint6   SB,
    input   uint1   powTWO,
    input   uint1   expODD,
    input   uint108 START_ac,
    input   uint106 START_x,
    output  uint54  squareroot
) <reginputs> {
    uint108             ac = uninitialised;
    uint106             x = uninitialised;
    uint6               i = uninitialised;
    uint6               iNEXT <:: i - 2;

    // Finished when the counter underflows (MSB becomes 1)
    uint1               FINISHED <:: i[5,1];

    // --- UNROLLED STEP 1 ---
    uint108             test_res_1 <:: ac - { squareroot, 2b01 };
    uint1               bit_1      <:: ~test_res_1[107,1];
    // Strict [0,105] slice matches original 107-bit width to protect the sign bit
    uint108             ac_1       <:: { bit_1 ? test_res_1[0,105] : ac[0,105], x[104,2] };
    uint54              sqrt_1     <:: { squareroot[0,53], bit_1 };

    // --- UNROLLED STEP 2 ---
    uint108             test_res_2 <:: ac_1 - { sqrt_1, 2b01 };
    uint1               bit_2      <:: ~test_res_2[107,1];
    uint108             ac_2       <:: { bit_2 ? test_res_2[0,105] : ac_1[0,105], x[102,2] };
    uint54              sqrt_2     <:: { sqrt_1[0,53], bit_2 };

    uint1               is_even_iters = uninitialised;

    uint2               STATE = 1;

    always {
        onehot( STATE ) {
            case 0: {
                BUSY = START & ~powTWO;
                if( START ) {
                    if( powTWO ) {
                        // Detect power of 2, return root 2 / 1 if exp odd / even
                        squareroot = expODD ? 54h2D413CCCFE7799 : 1;
                    } else {
                        i = SB;
                        squareroot = 0;
                        ac = START_ac;
                        x = START_x;

                        // If SB is even (e.g. 24 for Single), we will generate 26 bits
                        is_even_iters = ~SB[0,1];

                        STATE = 2; // STATE_FPU_SQRT
                    }
                }
            }
            case 1: {
                if( FINISHED ) {
                    BUSY = 0;
                    // Shift right by 1 to discard the 26th bit if Single Precision
                    if (is_even_iters) {
                        squareroot = squareroot >> 1;
                    }
                    STATE = 1; // STATE_FPU_SQRT_WAIT
                } else {
                    ac = ac_2;
                    squareroot = sqrt_2;

                    // Discard the 4 bits of x consumed across Step 1 and Step 2
                    x = { x[0,102], 4b00 };
                    i = iNEXT;
                }
            }
        }
        if( reset ) { BUSY = 0; STATE = 1; }
    }
}
// CASCADED/UNROLLED FLOATING POINT SQUARE ROOT (3 bits per cycle)
unit do_float_sqrt_radix8(
    input   uint1   START,
    output  uint1   BUSY(0),
    input   uint6   SB,
    input   uint1   powTWO,
    input   uint1   expODD,
    input   uint108 START_ac,
    input   uint106 START_x,
    output  uint54  squareroot
) <reginputs> {
    uint108             ac = uninitialised;
    uint106             x = uninitialised;

    // Use a 7-bit signed integer to safely detect underflow when subtracting 3
    uint7               i = uninitialised;
    uint7               iNEXT <:: i - 3;

    // Finished when the counter underflows (MSB becomes 1)
    uint1               FINISHED <:: i[6,1];

    // --- UNROLLED STEP 1 ---
    uint108             test_res_1 <:: ac - { squareroot, 2b01 };
    uint1               bit_1      <:: ~test_res_1[107,1];
    uint108             ac_1       <:: { bit_1 ? test_res_1[0,105] : ac[0,105], x[104,2] };
    uint54              sqrt_1     <:: { squareroot[0,53], bit_1 };

    // --- UNROLLED STEP 2 ---
    uint108             test_res_2 <:: ac_1 - { sqrt_1, 2b01 };
    uint1               bit_2      <:: ~test_res_2[107,1];
    uint108             ac_2       <:: { bit_2 ? test_res_2[0,105] : ac_1[0,105], x[102,2] };
    uint54              sqrt_2     <:: { sqrt_1[0,53], bit_2 };

    // --- UNROLLED STEP 3 ---
    uint108             test_res_3 <:: ac_2 - { sqrt_2, 2b01 };
    uint1               bit_3      <:: ~test_res_3[107,1];
    uint108             ac_3       <:: { bit_3 ? test_res_3[0,105] : ac_2[0,105], x[100,2] };
    uint54              sqrt_3     <:: { sqrt_2[0,53], bit_3 };

    uint2               shift_amt = uninitialised;

    uint2               STATE = 1;
                        $$ STATE_FPU_SQRT_WAIT  = 1
                        $$ STATE_FPU_SQRT       = 2

    always {
        onehot( STATE ) {
            case 0: {
                BUSY = START & ~powTWO;
                if( START ) {
                    if( powTWO ) {
                        // Detect power of 2, return root 2 / 1 if exp odd / even
                        squareroot = expODD ? 54h2D413CCCFE7799 : 1;
                    } else {
                        i = { 1b0, SB };
                        squareroot = 0;
                        ac = START_ac;
                        x = START_x;

                        // Because radix-8 generates exactly 27 bits over 9 iterations for Single Precision (SB == 24),
                        // but only 25 bits are required, we set an offset to shift by 2 at completion.
                        shift_amt = (SB == 24) ? 2b10 : 2b00;

                        STATE = $STATE_FPU_SQRT$;
                    }
                }
            }
            case 1: {
                if( FINISHED ) {
                    BUSY = 0;
                    squareroot = squareroot >> shift_amt;
                    STATE = $STATE_FPU_SQRT_WAIT$;
                } else {
                    ac = ac_3;
                    squareroot = sqrt_3;

                    // Discard the 6 bits of x consumed across Steps 1, 2, and 3
                    x = { x[0,100], 6b000000 };
                    i = iNEXT;
                }
            }
        }
        if( reset ) { BUSY = 0; STATE = 1; }
    }
}
unit floatsqrt(
    input   uint1   START,
    output  uint1   BUSY,
    input   uint2   dsh,                                                                                                        // DOUBLE/SINGLE/HALF FLAG
    input   uint10  BIAS,                                                                                                       // BIAS FOR DOUBLE/SINGLE/HALF
    input   uint3   rm,                                                                                                         // ROUNDING MODE FLAG
    input   uint64  a,                                                                                                          // A INPUT FOR SQRT(A)
    input   uint5   F1_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } FOR A
    input   uint6   SB,                                                                                                         // POINT TO START SQUAREROOT AT 53/24/11 FOR DOUBLE/SINGLE/HALF
    input   uint1   OF,
    input   uint1   UF,
    output  uint5   flags,                                                                                                      // OPERATION FLAGS
    output  uint7   special,
    output  uint54  fraction,
    output  int13   exponent
) <reginputs> {
    uint1               ACTION <:: ~( |F1_TYPE[0,4] | fp64( a ).sign );                                                        // CALCULATION VALID IF NORMAL POSITIVE NUMBER ( 0 IS SPECIAL )

    prep_float_sqrt PREP( BIAS <: BIAS, a <: a, squarerootexp :> exponent );                                                    // PREPARE THE SQUAREROOT INPUTS
    $FP_SQRT$ DOSQRT(                                                                                                       // CALCULATE SQUARE ROOT
        SB <: SB,
        powTWO <: F1_TYPE[4,1],
        expODD <: PREP.expODD,
        START_ac <: PREP.START_ac,
        START_x <: PREP.START_x,
        squareroot :> fraction
    );

    DOSQRT.START := START & ACTION; BUSY := START | DOSQRT.BUSY;                                                                // START AND BUSY FLAGS
    flags := { |F1_TYPE[1,3] | ( fp64( a ).sign & ~F1_TYPE[0,1] ), 1b0, ACTION & OF, ACTION & UF, 1b0 };                                           // RETURN FLAGS, INVALID IF INFINITY, NAN OR NEGATIVE
    special := ACTION ? 0 : ( fp64( a ).sign & ~F1_TYPE[0,1] ) ? 7b0000010 : 7b1000000;
}

