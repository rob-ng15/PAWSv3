// CPU PIPELINE STAGE 6B - COMMIT_F
// CONTROL THE WRITING OF EXECUTION RESULTS TO FLOATING-POINT REGISTERS
// CAN COMMIT ONE INSTRUCTION PER CYCLE
// POLLS EXECUTION STAGE UNITS IN ORDER OF PRIORITY
//  LSA-CSRFFPU

unit cpu_commit_f(
    $$for i=1,3 do
    simple_dualport_bram_port1 F$i$,                                                                                            // FLOAT REGISTERS WRITE PORT
    $$end

    input   uint1               EXECUTE_LSA_RESULT_F_READY,
    output  uint1               COMMIT_F_EXECUTE_LSA_RESULT_F_ACK,
    input   uint64              COMMIT_F_LSA_RESULT_F,                                                                              // FAST LSA EXECUTE RESULT
    input   uint5               COMMIT_F_LSA_REGISTER,                                                                            // FAST LSA EXECUTE RESULT REGISTER

    input   uint1               EXECUTE_CSRFPU_RESULT_F_READY,
    output  uint1               COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK,
    input   uint64              COMMIT_F_CSRFPU_RESULT_F,                                                                           // CSR AND FPU EXECUTE RESULT
    input   uint5               COMMIT_F_CSRFPU_REGISTER,                                                                         // CSR AND FPU EXECUTE RESULT REGISTER

    output  uint32              COMMIT_F_RD                                                                                       // INSTRUCTION COMMIT IS WRITING TO { FLOAT, RD }
) <reginputs> {
    uint5   ADDR <: EXECUTE_CSRFPU_RESULT_F_READY ? COMMIT_F_CSRFPU_REGISTER : COMMIT_F_LSA_REGISTER;
    uint1   WENABLE <: ( EXECUTE_CSRFPU_RESULT_F_READY | EXECUTE_LSA_RESULT_F_READY );
    uint64  WDATA <: EXECUTE_CSRFPU_RESULT_F_READY ? COMMIT_F_CSRFPU_RESULT_F : COMMIT_F_LSA_RESULT_F;

    $$for i=1,3 do
    F$i$.addr1 := ADDR;
    F$i$.wenable1 := WENABLE;
    F$i$.wdata1 := WDATA;
    $$end

    COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK := 0;
    COMMIT_F_EXECUTE_LSA_RESULT_F_ACK := 0;

    always {                                                                                                                    // ACCEPT RESULT AND COMMIT FROM EXECUTE STAGES
        COMMIT_F_RD = WENABLE << ADDR;

        if( EXECUTE_CSRFPU_RESULT_F_READY  ) {
            COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK = 1;
        } else {
            COMMIT_F_EXECUTE_LSA_RESULT_F_ACK = EXECUTE_LSA_RESULT_F_READY;
        }
    }
}
