// CPU PIPELINE STAGE 6B - COMMIT_F
// CONTROL THE WRITING OF EXECUTION RESULTS TO FLOATING-POINT REGISTERS
// CAN COMMIT ONE INSTRUCTION PER CYCLE
// POLLS EXECUTION STAGE UNITS IN ORDER OF PRIORITY
//  LSA-CSRFFPU

unit cpu_commit_f(
    $$for i=1,3 do
    simple_dualport_bram_port1 F$i$_E,                                                                                            // FLOAT REGISTERS WRITE PORT
    simple_dualport_bram_port1 F$i$_O,                                                                                            // FLOAT REGISTERS WRITE PORT
    $$end

    input   uint1               EXECUTE_LSA_RESULT_F_READY,
    output  uint1               COMMIT_F_EXECUTE_LSA_RESULT_F_ACK,
    input   uint64              COMMIT_F_LSA_RESULT_F,                                                                              // FAST LSA EXECUTE RESULT
    input   uint5               COMMIT_F_LSA_REGISTER,                                                                            // FAST LSA EXECUTE RESULT REGISTER

    input   uint1               EXECUTE_CSRFPU_RESULT_F_READY,
    output  uint1               COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK,
    input   uint64              COMMIT_F_CSRFPU_RESULT_F,                                                                           // CSR AND FPU EXECUTE RESULT
    input   uint5               COMMIT_F_CSRFPU_REGISTER,                                                                         // CSR AND FPU EXECUTE RESULT REGISTER

    output  uint32              COMMIT_F_RD                                                                                       // INSTRUCTION COMMIT IS WRITING TO { FLOAT, RD }
) <reginputs> {
    uint1   LSA_ACK_E <:: EXECUTE_LSA_RESULT_F_READY & ~COMMIT_F_LSA_REGISTER[0,1];
    uint1   CSRFPU_ACK_E <:: EXECUTE_CSRFPU_RESULT_F_READY & ~COMMIT_F_CSRFPU_REGISTER[0,1] & ~LSA_ACK_E;

    uint4   ADDR_E <:: LSA_ACK_E ? COMMIT_F_LSA_REGISTER[1,4] : COMMIT_F_CSRFPU_REGISTER[1,4];
    uint64  WDATA_E <:: LSA_ACK_E ? COMMIT_F_LSA_RESULT_F : COMMIT_F_CSRFPU_RESULT_F;
    uint1   WENABLE_E <:: LSA_ACK_E | CSRFPU_ACK_E;

    uint1   LSA_ACK_O <:: EXECUTE_LSA_RESULT_F_READY & COMMIT_F_LSA_REGISTER[0,1];
    uint1   CSRFPU_ACK_O <:: EXECUTE_CSRFPU_RESULT_F_READY & COMMIT_F_CSRFPU_REGISTER[0,1] & ~LSA_ACK_O;

    uint4   ADDR_O <:: LSA_ACK_O ? COMMIT_F_LSA_REGISTER[1,4] : COMMIT_F_CSRFPU_REGISTER[1,4];
    uint64  WDATA_O <:: LSA_ACK_O ? COMMIT_F_LSA_RESULT_F : COMMIT_F_CSRFPU_RESULT_F;
    uint1   WENABLE_O <:: LSA_ACK_O | CSRFPU_ACK_O;


    $$for i=1,3 do
        F$i$_E.addr1 := ADDR_E;
        F$i$_E.wenable1 := WENABLE_E;
        F$i$_E.wdata1 := WDATA_E;

        F$i$_O.addr1 := ADDR_O;
        F$i$_O.wenable1 := WENABLE_O;
        F$i$_O.wdata1 := WDATA_O;
    $$end

    COMMIT_F_EXECUTE_LSA_RESULT_F_ACK := LSA_ACK_E | LSA_ACK_O;
    COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK := CSRFPU_ACK_E | CSRFPU_ACK_O;

    COMMIT_F_RD :=  ( WENABLE_E  << { ADDR_E, 1b0 } ) | ( WENABLE_O  << { ADDR_O, 1b1 } );
}
