// NEW DMA MODULES
//  1x SET                      x == 0 TO S, == 1 TO M
//  2x COPY                     x == 0 S TO S, == 1 M TO S, == 2 S TO M, == 3 M TO M, == 4 + ( 1 SRC+ ) ( 2 DST+ )
//  40 SET RECTANGLE
//  80 COPY RECTANGLE
// DETERMINE 32/16/8 BIT TRANSFER CAPABILITY DIRECTLY FROM ADDRESS, STRIDE, COUNT AND MODE

unit dma_flags(
    input   uint16  DMADEST,
    input   uint4   DESTHIGH,                                                                                                   // HIGH 4 BITS OF DEST -> RAM/BITMAP/CMAP/BRAM/I/O
    input   uint16  DMASRC,                                                                                                     // LOW 16 BITS OF SOURCE
    input   uint4   SRCHIGH,                                                                                                    // HIGH 4 BITS OF SOURCE -> RAM/BITMAP/CMAP/BRAM/I/O
    input   uint2   DESTADD,                                                                                                    // LOW 2 BITS OF +D
    input   uint2   SRCADD,                                                                                                     // LOW 2 BITS OF +S
    input   uint2   COUNT,                                                                                                      // LOW 2 BITS OF COUNT
    input   uint1   mode_set,                                                                                                   // 1 = SET, 0 = COPY
    input   uint1   mode_stride,                                                                                                // 1 = USES SRCADD/DESTADD STRIDE
    output  uint2   ACCESSSIZE                                                                                                  // 2b10 = 32-BIT, 2b01 = 16-BIT, 2b00 = 8-BIT
) <reginputs> {
    uint1   DEST_BRAM <:: ( ~|DESTHIGH & ~DMADEST[15,1] );                                                                      // DESTINATION IS BRAM
    uint1   SRC_BRAM  <:: ( ~|SRCHIGH & ~DMASRC[15,1] );                                                                        // SOURCE IS BRAM
    uint1   DEST_32IO <:: ( ~|DESTHIGH & ( DMADEST[4,12] == 12hd38 ) );                                                         // DESTINATION IO 32 BIT ARGB
    uint1   DEST_16IO <:: ( ~|DESTHIGH & ( DMADEST[0,16] == 16hd342 ) );                                                        // DESTINATION IO 16 BIT SINGLE COLOUR BLITTER TILES

    uint1   SRC16     <:: ( |SRCHIGH | SRC_BRAM ) & ~DMASRC[0,1];
    uint1   SRC32     <:: ( |SRCHIGH[1,3] | SRC_BRAM ) & ~|DMASRC[0,2];
    uint1   SRCADD16  <:: ~SRCADD[0,1];
    uint1   SRCADD32  <:: ~|SRCADD[0,2];
    uint1   DEST16    <:: ( ( |DESTHIGH | DEST_BRAM ) & ~DMADEST[0,1] ) | DEST_16IO;
    uint1   DEST32    <:: ( ( |DESTHIGH[1,3] | DEST_BRAM ) & ~|DMADEST[0,2] ) | DEST_32IO;
    uint1   DESTADD16 <:: ~DESTADD[0,1];
    uint1   DESTADD32 <:: ~|DESTADD[0,2];
    uint1   COUNT16   <:: ~COUNT[0,1];
    uint1   COUNT32   <:: ~|COUNT[0,2];

    uint1   CAN32     <:: DEST32 & COUNT32 & ( mode_set | SRC32 ) & ( ~mode_stride | ( DESTADD32 & ( mode_set | SRCADD32 ) ) );
    uint1   CAN16     <:: DEST16 & COUNT16 & ( mode_set | SRC16 ) & ( ~mode_stride | ( DESTADD16 & ( mode_set | SRCADD16 ) ) );

    ACCESSSIZE := CAN32 ? 2b10 : CAN16 ? 2b01 : 2b00;
}

unit dma(                                                                                                                       // UNIFIED LINEAR & RECTANGLE DMA CONTROLLER
    input   uint$addr_width$    DMASOURCE,                                                                                      // DMA ADDRESSES, BYTES TO TRANSFER
    input   uint$addr_width$    DMASOURCEADD,
    input   uint$addr_width$    DMADEST,
    input   uint$addr_width$    DMADESTADD,
    input   uint$addr_width$    DMACOUNT,
    input   uint8               DMACYCLES,                                                                                      // FOR RECTANGLE MODE, NUMBER OF LINES
    input   uint32              DMASET,                                                                                         // CPU INPUT FOR SET VALUE

    input   uint1               DMASTART,                                                                                       // START FLAG
    input   uint8               DMAMODE,                                                                                        // TYPE OF DMA TRANSFER
    output  uint1               DMAACTIVE = 0,

    output  uint$addr_width$    MEM_ADDR,                                                                                       // MEMORY INTERFACE LINES
    output  uint2               MEM_SIZE,
    output  uint32              MEM_WDATA,
    output  uint1               MEM_WENABLE = 0,
    input   uint32              MEM_RDATA,
    output  uint1               MEM_RENABLE = 0,
    input   uint1               MEM_BUSY,
    input   uint1               MEM_ACK
) <reginputs> {
    uint5               STATE = 1;
                        $$ STATE_DMA_IDLE       = 1
                        $$ STATE_DMA_START      = 2
                        $$ STATE_DMA_READ_WAIT  = 4
                        $$ STATE_DMA_WRITE_WAIT = 8
                        $$ STATE_DMA_NEXT_LINE  = 16

    uint1               IS_RECT <:: |DMAMODE[6,2];                                                                              // 4h4 (SET RECT) OR 4h8 (COPY RECT)
    uint1               IS_SET  <:: DMAMODE[4,1] | DMAMODE[6,1];                                                                // 4h1 (SET)      OR 4h4 (SET RECT)

    uint3               dmamode = uninitialised;                                                                                // [0]=SRC+, [1]=DEST+, [2]=ADD STRIDE
    uint1               mode_set = uninitialised;
    uint1               mode_stride = uninitialised;

    uint$addr_width$    dmasrc = uninitialised;                                                                                 // CURRENT SOURCE ADDRESS
    uint$addr_width$    dmadest = uninitialised;                                                                                // CURRENT DESTINATION ADDRESS
    uint$addr_width$    dmacount = uninitialised;                                                                               // BYTES LEFT IN CURRENT LINE
    uint8               dmacycles = uninitialised;                                                                              // LINES LEFT (1 FOR LINEAR, DMACYCLES FOR RECT)

    dma_flags FLAGS(
        DESTHIGH <: DMADEST[$addr_width-4$,4], DMADEST <: DMADEST[0,16],
        SRCHIGH <: DMASOURCE[$addr_width-4$,4], DMASRC <: DMASOURCE[0,16],
        DESTADD <: DMADESTADD[0,2], SRCADD <: DMASOURCEADD[0,2],
        COUNT <: DMACOUNT[0,2],
        mode_set <: mode_set,
        mode_stride <: mode_stride,
        ACCESSSIZE :> MEM_SIZE
    );

    uint3               STEP <:: ( 1 << FLAGS.ACCESSSIZE );
    uint$addr_width$    dmasrc_NEXT   <:: dmamode[0,1] ? ( dmasrc + ( dmamode[2,1] ? DMASOURCEADD : STEP ) ) : dmasrc;
    uint$addr_width$    dmadest_NEXT  <:: dmamode[1,1] ? ( dmadest + ( dmamode[2,1] ? DMADESTADD : STEP ) ) : dmadest;
    uint$addr_width$    dmacount_NEXT <:: dmacount - STEP;

    uint$addr_width$    dmasrc_NEXTCYCLE  <:: dmasrc + DMASOURCEADD - DMACOUNT;
    uint$addr_width$    dmadest_NEXTCYCLE <:: dmadest + DMADESTADD - DMACOUNT;
    uint8               dmacycles_NEXT    <:: dmacycles - 1;

    uint1               WAIT_MEM <:: MEM_RENABLE | MEM_WENABLE | MEM_BUSY;

    always {
        if( MEM_ACK ) { MEM_RENABLE = 0; MEM_WENABLE = 0; }

        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_DMA_IDLE
                dmasrc = DMASOURCE;
                dmadest = DMADEST;
                dmacount = DMACOUNT;
                dmacycles = IS_RECT ? DMACYCLES : 1;
                dmamode = IS_RECT ? 3b011 : DMAMODE[0,3];
                mode_set = IS_SET;
                mode_stride = IS_RECT | ( DMAMODE[5,1] & DMAMODE[2,1] );
                MEM_WDATA = DMASET;

                if( DMASTART & |DMAMODE[4,4] ) {
                    DMAACTIVE = 1;
                    STATE = $STATE_DMA_START$;
                }
            }

            case 1: {                                                                                                           // STATE_DMA_START
                if( |dmacount & |dmacycles ) {
                    if( mode_set ) {
                        MEM_ADDR = dmadest;
                        MEM_WENABLE = 1;
                        STATE = $STATE_DMA_WRITE_WAIT$;
                    } else {
                        MEM_ADDR = dmasrc;
                        MEM_RENABLE = 1;
                        STATE = $STATE_DMA_READ_WAIT$;
                    }
                } else {
                    DMAACTIVE = 0;
                    STATE = $STATE_DMA_IDLE$;
                }
            }

            case 2: {                                                                                                           // STATE_DMA_READ_WAIT
                if( ~WAIT_MEM ) {
                    MEM_ADDR = dmadest;
                    MEM_WDATA = |FLAGS.ACCESSSIZE ? MEM_RDATA : MEM_RDATA[ { dmasrc[0,1], 3b000 }, 8 ];
                    MEM_WENABLE = 1;
                    STATE = $STATE_DMA_WRITE_WAIT$;
                }
            }

            case 3: {                                                                                                           // STATE_DMA_WRITE_WAIT
                if( ~WAIT_MEM ) {
                    dmasrc = dmasrc_NEXT;
                    dmadest = dmadest_NEXT;
                    dmacount = dmacount_NEXT;

                    if( |dmacount_NEXT ) {
                        STATE = $STATE_DMA_START$;
                    } else {
                        if( |dmacycles_NEXT ) {
                            STATE = $STATE_DMA_NEXT_LINE$;
                        } else {
                            DMAACTIVE = 0;
                            STATE = $STATE_DMA_IDLE$;
                        }
                    }
                }
            }

            case 4: {                                                                                                           // STATE_DMA_NEXT_LINE
                dmasrc = dmasrc_NEXTCYCLE;
                dmadest = dmadest_NEXTCYCLE;
                dmacount = DMACOUNT;
                dmacycles = dmacycles_NEXT;
                STATE = $STATE_DMA_START$;
            }
        }

        if( reset ) { DMAACTIVE = 0; MEM_RENABLE = 0; MEM_WENABLE = 0; STATE = $STATE_DMA_IDLE$; }
    }
}

// DIGITAL AUDIO DMA, PLAYS 8 BIT SAMPLES AT APPROXIMATELY 11025KHz or 22050KHz, USING A JUST IN TIME DMA MEMORY FETCHING SYSTEM
// 11025KHz/22050KHz timer for audio dma
unit pulse11025(
    output  uint1               UPDATE,
    input   uint1               START,
    input   uint1               STOP,
    input   uint1               RATE
) <reginputs> {
    uint2               STATE = 1;
                        $$ STATE_PULSE_INACTIVE = 1
                        $$ STATE_PULSE_ACTIVE   = 2

    uint13              counter50mhz = uninitialised;
    uint13              counter50mhz_m1 <:: counter50mhz - 1;
    UPDATE := STATE[1,1] & ~|counter50mhz;

    always {
        onehot( STATE ) {
            case 0: { if( START ) { counter50mhz = RATE ? 2267 : 4535; STATE = $STATE_PULSE_ACTIVE$; } }                        // STATE_PULSE_INACTIVE
            case 1: {                                                                                                           // STATE_PULSE_ACTIVE
                if( ~|counter50mhz ) {                                                                                          //  START NEW TIMER OR CONTINUE COUNTING DOWN?
                    counter50mhz = RATE ? 2267 : 4535;
                } else {
                    counter50mhz = counter50mhz_m1;
                }
            }
        }

        if( STOP ) { STATE = $STATE_PULSE_INACTIVE$; }
    }
}

unit dma_digital_audio(
    output  uint$addr_width$    MEM_ADDR,                                                                                       // MEMORY INTERFACE LINES
    input   uint32              MEM_RDATA,
    output  uint1               MEM_RENABLE,
    input   uint1               MEM_BUSY,
    input   uint1               MEM_ACK,

    // DMA DIGITAL AUDIO SAMPLES
    output  uint1               L_ADMA_ACTIVE,
    output  uint8               L_AUDIO_DMA_SAMPLE,
    input   uint4               L_AUDIO_DMA_STATUS,
    input   uint$addr_width$    L_AUDIO_DMA_BASE,
    input   uint$addr_width$    L_AUDIO_DMA_LENGTH,
    input   uint1               L_AUDIO_DMA_REPEAT,

    output  uint1               R_ADMA_ACTIVE,
    output  uint8               R_AUDIO_DMA_SAMPLE,
    input   uint4               R_AUDIO_DMA_STATUS,
    input   uint$addr_width$    R_AUDIO_DMA_BASE,
    input   uint$addr_width$    R_AUDIO_DMA_LENGTH,
    input   uint1               R_AUDIO_DMA_REPEAT
) <reginputs> {
    uint7               STATE = 1;

    pulse11025 L_UPDATE(
        START <: L_AUDIO_DMA_STATUS[1,1],
        STOP <: L_AUDIO_DMA_STATUS[0,1]
    );
    dma_digital_audio_channel LEFT(
        READDATA <: MEM_RDATA,
        BASE <: L_AUDIO_DMA_BASE,
        LENGTH <: L_AUDIO_DMA_LENGTH,
        START <: L_AUDIO_DMA_STATUS[1,1],
        STOP <: L_AUDIO_DMA_STATUS[0,1],
        UPDATE <: L_UPDATE.UPDATE,
        SAMPLE :> L_AUDIO_DMA_SAMPLE,
        ADMA_ACTIVE :> L_ADMA_ACTIVE
    );

    pulse11025 R_UPDATE(
        START <: R_AUDIO_DMA_STATUS[1,1],
        STOP <: R_AUDIO_DMA_STATUS[0,1]
    );
    dma_digital_audio_channel RIGHT(
        READDATA <: MEM_RDATA,
        BASE <: R_AUDIO_DMA_BASE,
        LENGTH <: R_AUDIO_DMA_LENGTH,
        START <: R_AUDIO_DMA_STATUS[1,1],
        STOP <: R_AUDIO_DMA_STATUS[0,1],
        UPDATE <: R_UPDATE.UPDATE,
        SAMPLE :> R_AUDIO_DMA_SAMPLE,
        ADMA_ACTIVE :> R_ADMA_ACTIVE
    );

    LEFT.DMASTART := 0;
    RIGHT.DMASTART := 0;

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_ADMA_WAIT
                if( LEFT.DMAREQ ) {
                    LEFT.DMASTART = 1; STATE = 2;
                } else {
                    if( RIGHT.DMAREQ ) {
                        RIGHT.DMASTART = 1; STATE = 16;
                    }
                }
            }
            case 1: { if( LEFT.READFLAG ) { MEM_ADDR = LEFT.ADDRESS; MEM_RENABLE = 1; LEFT.MEMORYBUSY = 1; STATE = 4; } }       // STATE_ADMA_WAIT_LEFT
            case 2: { if( MEM_ACK ) { MEM_RENABLE = 0; STATE = 8; } }
            case 3: { if( ~MEM_BUSY ) { LEFT.MEMORYBUSY = 0; STATE = 1; } }

            case 4: { if( RIGHT.READFLAG ) { MEM_ADDR = RIGHT.ADDRESS; MEM_RENABLE = 1; RIGHT.MEMORYBUSY = 1; STATE = 32; } }       // STATE_ADMA_WAIT_LEFT
            case 5: { if( MEM_ACK ) { MEM_RENABLE = 0; STATE = 64; } }
            case 6: { if( ~MEM_BUSY ) { RIGHT.MEMORYBUSY = 0; STATE = 1; } }
        }

        if( |L_AUDIO_DMA_STATUS ) { L_UPDATE.RATE = L_AUDIO_DMA_STATUS[3,1]; LEFT.REPEAT = L_AUDIO_DMA_STATUS[2,1]; }
        if( |R_AUDIO_DMA_STATUS ) { R_UPDATE.RATE = R_AUDIO_DMA_STATUS[3,1]; RIGHT.REPEAT = R_AUDIO_DMA_STATUS[2,1]; }
    }
}

unit dma_digital_audiosamples_latch(
    input   uint1               START,
    input   uint1               STOP,
    input   uint32              READDATA,
    input   uint1               LATCH,
    input   uint1               UPDATE,

    output  uint1               REQ_NEWSAMPLES,
    input   uint1               ACK_REQ_NEWSAMPLES,
    output  uint8               SAMPLE,
    output  uint2               BYTE
) <reginputs> {
    uint2   BYTE_NEXT <:: BYTE + 1;
    uint1   FIRST = uninitialised;
    uint32  samples = uninitialised;

    always {
        if( UPDATE ) { SAMPLE = samples[ { BYTE, 3b000 }, 8 ]; }
        if( LATCH ) {
            samples = READDATA;
            if( FIRST ) { SAMPLE = READDATA[0,8]; FIRST = 0; }
        }
        REQ_NEWSAMPLES = UPDATE ? &BYTE : ( START | STOP | ACK_REQ_NEWSAMPLES ) ? 0 : REQ_NEWSAMPLES;
        BYTE = START ? 2b01 : UPDATE ? BYTE_NEXT : BYTE;
        if( START ) { FIRST = 1; }
    }
}

unit dma_digital_audio_channel(
    input   uint$addr_width$    BASE,
    input   uint$addr_width$    LENGTH,
    input   uint1               START,
    input   uint1               STOP,
    input   uint1               REPEAT,

    input   uint1               UPDATE,
    output  uint8               SAMPLE,
    output  uint1               ADMA_ACTIVE,
    output  uint$addr_width$    ADDRESS,
    output  uint1               READFLAG,
    input   uint32              READDATA,
    input   uint1               MEMORYBUSY,

    input   uint1               DMASTART,
    output  uint1               DMAREQ,
    output  uint1               DMAACTIVE
) <reginputs> {
    uint7               STATE = 1;
                        $$ STATE_ADMA_CHANNEL_IDLE          = 1
                        $$ STATE_ADMA_CHANNEL_WAIT_START    = 2
                        $$ STATE_ADMA_CHANNEL_WAIT_MEMORY   = 4
                        $$ STATE_ADMA_CHANNEL_LATCH_SAMPLE  = 8
                        $$ STATE_ADMA_CHANNEL_NEXT_ADDR     = 16
                        $$ STATE_ADMA_CHANNEL_WAIT_LOADNEW  = 32
                        $$ STATE_ADMA_CHANNEL_WAIT_FINISH   = 64

    uint$addr_width$ ADDRESS_NEXT <:: ADDRESS + 4;
    uint1            AT_LAST <:: ( ADDRESS_NEXT >= ( BASE + LENGTH ) );
    uint1            FINISHED <:: ( ( ADDRESS + SAMPLES.BYTE - BASE ) < LENGTH );

    dma_digital_audiosamples_latch SAMPLES( START <: START, STOP <: STOP, UPDATE <: UPDATE, LATCH <: STATE[3,1], READDATA <: READDATA, SAMPLE :> SAMPLE );
    SAMPLES.ACK_REQ_NEWSAMPLES := STATE[0,1] | ( STATE[5,1] & SAMPLES.REQ_NEWSAMPLES );

    DMAACTIVE := DMASTART | STATE[2,1];
    DMAREQ := ( START & STATE[0,1] ) | ( SAMPLES.REQ_NEWSAMPLES & STATE[5,1] ) | ( STATE[1,1] & ~DMASTART );
    READFLAG := DMASTART & STATE[1,1];
    ADMA_ACTIVE := ~STATE[0,1];

    always {
        onehot( STATE ) {
            case 0: { if( START ) { ADDRESS = BASE; STATE = $STATE_ADMA_CHANNEL_WAIT_START$; }  }                               // STATE_ADMA_CHANNEL_IDLE
            case 1: { if( DMASTART ) { STATE = $STATE_ADMA_CHANNEL_WAIT_MEMORY$; } }                                            // STATE_ADMA_CHANNEL_WAIT_START
            case 2: { if( ~MEMORYBUSY ) { STATE = $STATE_ADMA_CHANNEL_LATCH_SAMPLE$; } }                                        // STATE_ADMA_CHANNEL_WAIT_MEMORY
            case 3: { STATE = $STATE_ADMA_CHANNEL_NEXT_ADDR$; }                                                                 // STATE_ADMA_CHANNEL_LATCH_SAMPLE
            case 4: {                                                                                                           // STATE_ADMA_CHANNEL_NEXT_ADDR
                if( AT_LAST ) {
                    if( REPEAT ) {
                        ADDRESS = BASE; STATE = $STATE_ADMA_CHANNEL_WAIT_LOADNEW$;
                    } else {
                        STATE = $STATE_ADMA_CHANNEL_WAIT_FINISH$;
                    }
                } else {
                    ADDRESS = ADDRESS_NEXT; STATE = $STATE_ADMA_CHANNEL_WAIT_LOADNEW$;
                }
            }            case 5: { if( SAMPLES.REQ_NEWSAMPLES ) { STATE = $STATE_ADMA_CHANNEL_WAIT_START$; } }                               // STATE_ADMA_CHANNEL_WAIT_LOADNEW
            case 6: { STATE = FINISHED ? STATE : $STATE_ADMA_CHANNEL_IDLE$; }                                                   // STATE_ADMA_CHANNEL_WAIT_FINISH
        }

        if( STOP ) { STATE = $STATE_ADMA_CHANNEL_IDLE$; }                                                                       // STOP, RETURN TO IDLE AND CANCEL ANY LOAD
    }
}
