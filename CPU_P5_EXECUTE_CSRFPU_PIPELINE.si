    // EXECUTE_CSRFPU_FLAGS = { STORE, LOAD, JUMP, FPU_FAST, FPU_CONVERT, FPU, FENCE, CSR, ATOMIC, ALU_SIGNX, ALU_FAST, ALU, WR_F, WR }
    $$ EX_CSRFPU_IS_WR =          "EXECUTE_CSRFPU_FLAGS[ 0,1]"
    $$ EX_CSRFPU_IS_WR_F =        "EXECUTE_CSRFPU_FLAGS[ 1,1]"
    $$ EX_CSRFPU_IS_CSR =         "EXECUTE_CSRFPU_FLAGS[ 2,1]"
    $$ EX_CSRFPU_IS_FPU =         "EXECUTE_CSRFPU_FLAGS[ 3,1]"
    $$ EX_CSRFPU_IS_FPU_CONVERT = "EXECUTE_CSRFPU_FLAGS[ 4,1]"
    $$ EX_CSRFPU_IS_FPU_FAST =    "EXECUTE_CSRFPU_FLAGS[ 5,1]"

unit cpu_execute_csrfpu(
    input   uint1               clock_decode,

    $$for i=1,3 do
    input   uint64              EXECUTE_CSRFPU_F$i$,                                                                            // FLOAT REGISTERS
    $$end
    input   uint64              EXECUTE_CSRFPU_I1,                                                                              // INTEGER REGISTER
    input   uint64              EXECUTE_CSRFPU_I1_ABS64,                                                                        // ABSOLUTE VALUE OF INTEGER REGISTER FOR CONVERSIONS
    input   uint32              EXECUTE_CSRFPU_I1_ABS32,

    output  uint1               EXECUTE_CSRFPU_READY,
    input   uint1               EXECUTE_CSRFPU_ACK,

    input   uint32              EXECUTE_CSRFPU_INSTRUCTION,
    input   uint6               EXECUTE_CSRFPU_FLAGS,

    output  uint1               EXECUTE_CSRFPU_RESULT_READY,
    input   uint1               COMMIT_EXECUTE_CSRFPU_RESULT_ACK,
    output  uint64              COMMIT_CSRFPU_RESULT,
    output  uint5               COMMIT_CSRFPU_REGISTER,

    output  uint1               EXECUTE_CSRFPU_RESULT_F_READY,
    input   uint1               COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK,
    output  uint64              COMMIT_CSRFPU_F_RESULT,
    output  uint5               COMMIT_CSRFPU_F_REGISTER,

    output  uint64              EXECUTE_CSRFPU_RD,                                                                              // INSTRUCTION IN EXECUTE IS WRITING TO { FLOAT, RD }

    output  uint$addr_width$    CSR_MEPC,
    output  uint$addr_width$    CSR_MTVEC,
    output  uint1               CSR_IRQ_PENDING,
    output  uint4               CSR_IRQ_VECTOR,
    input   uint1               CSR_IRQ_ACK,
    output  uint1               CSR_IRQ_ACK_ACK,
    input   uint1               CSR_IRQ_END,
    output  uint1               CSR_IRQ_END_ACK,
    input   uint1               CSR_ECALL_REQ,
    input   uint$addr_width$    CSR_NEW_MEPC,

    input   uint1               DMA_ACTIVE,                                                                                     // DMA AUDIO/COPY/SET IS ACTIVE

    input   uint$CWIDTH$        IRQ_TIMER,                                                                                      // IRQ TIMER TRIGGER VALUE
    input   uint1               TIMER_VALID,                                                                                    // HAS IRQ TIMER TRIGGER VALUE BEEN FULLY SET
    input   uint$CWIDTH$        RDTIME,
    input   uint1               IRQ_VBLANK,                                                                                     // IRQ VBLANK

    input   uint3               CSR_INC_INSNRET
) <reginputs> {
$$if VERILATOR then
    uint64  COMMITS[4] = { 0, 0, 0, 0 };
    uint24  COUNT = 0;
$$end

    uint6               STATE = 1;

    brom uint14 immediate_rom[96] = {                                                                                           // FLOATING-POINT IMMEDIATE LOOKUP TABLE
                                                                                                                                // SINGLE PRECISION { 1b sign, 8b exponent, 2b msb of mantissa }
        11b10111111100,                                                                                                         // -1.0
        11b00000000100,                                                                                                         // minimum positive normal
        11b00110111100,                                                                                                         // 1 x 2^-16
        11b00111000000,                                                                                                         // 1 x 2^-15
        11b00111011100,                                                                                                         // 1 x 2^-8
        11b00111100000,                                                                                                         // 1 x 2^-7
        11b00111101100,                                                                                                         // 0.0625
        11b00111110000,                                                                                                         // 0.125
        11b00111110100,                                                                                                         // 0.25
        11b00111110101,                                                                                                         // 0.3125
        11b00111110110,                                                                                                         // 0.375
        11b00111110111,                                                                                                         // 0.4375
        11b00111111000,                                                                                                         // 0.5
        11b00111111001,                                                                                                         // 0.625
        11b00111111010,                                                                                                         // 0.75
        11b00111111011,                                                                                                         // 0.875
        11b00111111100,                                                                                                         // 1.0
        11b00111111101,                                                                                                         // 1.25
        11b00111111110,                                                                                                         // 1.5
        11b00111111111,                                                                                                         // 1.75
        11b01000000000,                                                                                                         // 2.0
        11b01000000001,                                                                                                         // 2.5
        11b01000000010,                                                                                                         // 3.0
        11b01000000100,                                                                                                         // 4.0
        11b01000001000,                                                                                                         // 8.0
        11b01000001100,                                                                                                         // 16.0
        11b01000011000,                                                                                                         // 128 2^7
        11b01000011100,                                                                                                         // 256 2^8
        11b01000111000,                                                                                                         // 2^15
        11b01000111100,                                                                                                         // 2^16
        11b01111111100,                                                                                                         // +INF
        11b01111111110,                                                                                                         // NaN

                                                                                                                                // DOUBLE PRECISION { 1b sign, 11b exponent, 2b msb of mantissa }
        14b10111111111100,                                                                                                      // -1.0
        14b00000000000100,                                                                                                      // minimum positive normal
        14b00111110111100,                                                                                                      // 1 x 2^-16
        14b00111111000000,                                                                                                      // 1 x 2^-15
        14b00111111011100,                                                                                                      // 1 x 2^-8
        14b00111111100000,                                                                                                      // 1 x 2^-7
        14b00111111101100,                                                                                                      // 0.0625
        14b00111111110000,                                                                                                      // 0.125
        14b00111111110100,                                                                                                      // 0.25
        14b00111111110101,                                                                                                      // 0.3125
        14b00111111110110,                                                                                                      // 0.375
        14b00111111110111,                                                                                                      // 0.4375
        14b00111111111000,                                                                                                      // 0.5
        14b00111111111001,                                                                                                      // 0.625
        14b00111111111010,                                                                                                      // 0.75
        14b00111111111011,                                                                                                      // 0.875
        14b00111111111100,                                                                                                      // 1.0
        14b00111111111101,                                                                                                      // 1.25
        14b00111111111110,                                                                                                      // 1.5
        14b00111111111111,                                                                                                      // 1.75
        14b01000000000000,                                                                                                      // 2.0
        14b01000000000001,                                                                                                      // 2.5
        14b01000000000010,                                                                                                      // 3.0
        14b01000000000100,                                                                                                      // 4.0
        14b01000000001000,                                                                                                      // 8.0
        14b01000000001100,                                                                                                      // 16.0
        14b01000000011000,                                                                                                      // 128 2^7
        14b01000000011100,                                                                                                      // 256 2^8
        14b01000000111000,                                                                                                      // 2^15
        14b01000000111100,                                                                                                      // 2^16
        14b01111111111100,                                                                                                      // +INF
        14b01111111111110,                                                                                                      // NaN

                                                                                                                                // HALF PRECISION { 1b sign, 5b exponent, 2b msb of mantissa }
        8b10111100,                                                                                                             // -1.0
        8b00000100,                                                                                                             // minimum positive normal
        8b00000000,                                                                                                             // 1 x 2^-16 ( subnormal -> 0 )
        8b00000000,                                                                                                             // 1 x 2^-15 ( subnormal -> 0 )
        8b00011100,                                                                                                             // 1 x 2^-8
        8b00100000,                                                                                                             // 1 x 2^-7
        8b00101100,                                                                                                             // 0.0625
        8b00110000,                                                                                                             // 0.125
        8b00110100,                                                                                                             // 0.25
        8b00110101,                                                                                                             // 0.3125
        8b00110110,                                                                                                             // 0.375
        8b00110111,                                                                                                             // 0.4375
        8b00111000,                                                                                                             // 0.5
        8b00111001,                                                                                                             // 0.625
        8b00111010,                                                                                                             // 0.75
        8b00111011,                                                                                                             // 0.875
        8b00111100,                                                                                                             // 1.0
        8b00111101,                                                                                                             // 1.25
        8b00111110,                                                                                                             // 1.5
        8b00111111,                                                                                                             // 1.75
        8b01000000,                                                                                                             // 2.0
        8b01000001,                                                                                                             // 2.5
        8b01000010,                                                                                                             // 3.0
        8b01000100,                                                                                                             // 4.0
        8b01001000,                                                                                                             // 8.0
        8b01001100,                                                                                                             // 16.0
        8b01011000,                                                                                                             // 128 2^7
        8b01100100,                                                                                                             // 256 2^8
        8b01111000,                                                                                                             // 2^15
        8b01111100,                                                                                                             // +INF
        8b01111100,                                                                                                             // +INF
        8b01111110                                                                                                              // NaN
    };

    uint10              BIAS_TABLE[4] = { $BIAS32$, $BIAS64$, $BIAS16$, 10b1111111111 };                                        // BIAS FOR DIFFERENT PRECISIONS
    uint3               operation <:: {                                                                                         // PRESENT INSTRUCTION ROUTE
                                        ~( $EX_CSRFPU_IS_FPU_FAST$ | $EX_CSRFPU_IS_FPU_CONVERT$ ),
                                        $EX_CSRFPU_IS_FPU_CONVERT$,
                                        $EX_CSRFPU_IS_FPU_FAST$
                                      };
    uint2               RMODE <:: &Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3 ? CSR.OUT_FPUFLAGS[5,2] :                             // ROUNDING MODE FROM INSTRUCTION OR FRM
                                                                            Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[0,2];
    uint5               ACTION <:: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).opp[4,1] ?
                                        ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,2] == 2b10 ) ? 5b00010 :                     // IDENTIFY UNIT { fused, sqrt, div, mul, add }
                                        ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,2] == 2b11 ) ?                               //                 4      3     2    1    0
                                                { 1b0, Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[5,1], ~Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[5,1], 2b00 } :
                                                                              5b00001 :
                                                                              5b10000;
    uint3               CNV_TYPE <:: {
                                        ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b11000 ),                             // FD2IL
                                        ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b11010 ),                             // IL2FD
                                        ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b01000 )                              // CHANGE PRECISION HSD <-> HSD, FROUND IF RS2[2,1]
                                     };
    uint6               CNV_MB[4] = { 29, 0, 42, -1 };                                                                          // SHIFT AMOUNT TO PUT ROUNDING BIT INTO THE CORRECT POSITION
    int13               CNV_EXP <:: fp64( REPACK_F1.repack ).exponent -                                                         // EXTRACT EXPONENT AND REMOVE BIAS
                                    BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];

    uint7   FAST_TYPE <:: {
                            ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b11100 ) & Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[0,1],   // FCLASS
                            ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b11110 ) & Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,1],  // FLI
                            ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b11100 ) & ~Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[0,1],   // FMV F -> I
                            ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b11110 ) & ~Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,1], // FMV I -> F
                            Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b00100,                                                 // FSGNJ FSGNJN FSGNJX
                            Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b10100,                                                 // FEQ FLT FLE
                            Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5] == 5b00101                                                  // FMIN FMAX
                          };

    typeF TYPE_F1 <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F1 );               // CLASSIFY F1 { ZF, INF, sNAN, qNAN, ZERO }
    typeF TYPE_F2 <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F2 );               // CLASSIFY F2 { ZF, INF, sNAN, qNAN, ZERO }
    typeF TYPE_F3 <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F3 );               // CLASSIFY F3 { ZF, INF, sNAN, qNAN, ZERO }
    typeF TYPE_CP <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,2], a <: EXECUTE_CSRFPU_F1 );              // FORCE CLASSIFICATION FOR changeprecision
    repackage_wide REPACK_F1 <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F1 );    // PACK F1 FIELDS INTO BITFIELDS OF DOUBLE-PRECISION
    repackage_wide REPACK_F2 <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F2 );    // PACK F2 FIELDS INTO BITFIELDS OF DOUBLE-PRECISION
    repackage_wide REPACK_F3 <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F3 );    // PACK F3 FIELDS INTO BITFIELDS OF DOUBLE-PRECISION
    repackage_wide REPACK_CP <@clock_decode> ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,2], a <: EXECUTE_CSRFPU_F1 );   // changeprecision SIGN, EXPONENT (with bias), FRACTION

    uint3   FLTEQ <:: { FPUcompare.equal, FPUcompare.less, FPUcompare.less | FPUcompare.equal };
    floatcompare FPUcompare <@clock_decode> (                                                                                   // FLOATING POINT COMPARISONS
        a <: REPACK_F1.repack, b <: REPACK_F2.repack,                                                                           // PASS REPACKED VALUES TO COMPARE
        F1_ZERO_FRACTION <: TYPE_F1.type[4,1],                                                                                  // A FRACTION 0?
        F2_ZERO_FRACTION <: TYPE_F2.type[4,1]                                                                                   // B FRACTION 0?
    );

    CSRblock CSR(                                                                                                               // RISC-V CSR REGISTERS + INTERRUPT CONTROLLER
        INC_INSNRET <: CSR_INC_INSNRET,                                                                                         // INSTRUCTION RETIRED FLAGS
        DMA_ACTIVE <: DMA_ACTIVE,                                                                                               // FOR PERFORMANCE COUNTERS
        PC_NEXT <: CSR_NEW_MEPC,                                                                                                // NEXT INSTRUCTION FOR MEPC
        RDTIME <: RDTIME, IRQ_VBLANK <: IRQ_VBLANK, IRQ_TIMER <: IRQ_TIMER, TIMER_VALID <: TIMER_VALID,                         // HARDWARE IRQ FLAGS
        CSR_ECALL_REQ <: CSR_ECALL_REQ,                                                                                         // SOFTWARE IRQ FLAG
        CSR_MEPC :> CSR_MEPC, CSR_MTVEC :> CSR_MTVEC,                                                                           //  TO/FROM FETCH IRQ CONTROL SIGNALS
        IRQ_PENDING :> CSR_IRQ_PENDING, IRQ_VECTOR :> CSR_IRQ_VECTOR,
        IRQ_ACK <: CSR_IRQ_ACK, IRQ_ACK_ACK :> CSR_IRQ_ACK_ACK, IRQ_END <: CSR_IRQ_END, IRQ_END_ACK :> CSR_IRQ_END_ACK,         // CS[R][W] INSTRUCTION FLAGS AND VALUES
        function3 <: CSR( EXECUTE_CSRFPU_INSTRUCTION ).f3, rs1 <: CSR( EXECUTE_CSRFPU_INSTRUCTION ).sr1,
        CSR_REG <: CSR( EXECUTE_CSRFPU_INSTRUCTION ).csr, I1 <: EXECUTE_CSRFPU_I1
    );

    fpufast_minmax_execute FAST_MNX( COMMIT_F_ACK <: COMMIT_F.FPUFAST_MNX_ACK );                                                    // FPU EXECUTION BLOCKS     MIN/MAX
    fpufast_fsnj_execute FAST_SNJ( COMMIT_F_ACK <: COMMIT_F.FPUFAST_SNJ_ACK );                                                      // FPU EXECUTION BLOCKS     SGN
    fpufast_compare_execute FAST_CMP( COMMIT_ACK <: COMMIT_I.FPUFAST_CMP_ACK );                                                     // FPU EXECUTION BLOCKS     LT LE
    fpufast_fli_execute FAST_FLI( COMMIT_F_ACK <: COMMIT_F.FPUFAST_FLI_ACK );                           // FPU EXECUTION BLOCKS     LI
    fpufast_cls_execute FAST_CLS( COMMIT_ACK <: COMMIT_I.FPUFAST_CLS_ACK );                           // FPU EXECUTION BLOCKS     CLASS
    fpufast_mv2i_execute FAST_M2I( COMMIT_ACK <: COMMIT_I.FPUFAST_M2I_ACK );                           // FPU EXECUTION BLOCKS     MV -> I
    fpufast_mv2f_execute FAST_M2F( COMMIT_F_ACK <: COMMIT_F.FPUFAST_M2F_ACK );                           // FPU EXECUTION BLOCKS     MV -> F
    fpuconvert_i2f_execute CONVERT_I2F( COMMIT_F_ACK <: COMMIT_F.FPUCONVERT_I2F_ACK );                                          //                          CONVERSIONS
    fpuconvert_f2i_execute CONVERT_F2I( COMMIT_ACK <: COMMIT_I.FPUCONVERT_F2I_ACK );                                            //                          CONVERSIONS
    fpuconvert_cp_execute CONVERT_CP( COMMIT_F_ACK <: COMMIT_F.FPUCONVERT_CP_ACK );                                             //                          CONVERSIONS
    fpuconvert_r_execute CONVERT_R( COMMIT_F_ACK <: COMMIT_F.FPUCONVERT_R_ACK );                                                //                          CONVERSIONS
    fpucalc_fma_execute CALC_FMA( COMMIT_ACK <: COMMIT_F.FPUCALC_FMA_ACK );                                                     //                          + - * AND FUSED
    fpucalc_div_execute CALC_DIV( COMMIT_ACK <: COMMIT_F.FPUCALC_DIV_ACK );                                                     //                          /
    fpucalc_sqrt_execute CALC_SQRT( COMMIT_ACK <: COMMIT_F.FPUCALC_SQRT_ACK );                                                  //                          SQUARE ROOT

    csrfpu_commit_i COMMIT_I(                                                                                                   // COMMIT TO INTEGR REGISTER
        RESULT_READY :> EXECUTE_CSRFPU_RESULT_READY,
        COMMIT_EXECUTE_CSRFPU_RESULT_ACK <: COMMIT_EXECUTE_CSRFPU_RESULT_ACK,
        COMMIT_CSRFPU_RESULT :> COMMIT_CSRFPU_RESULT,
        COMMIT_CSRFPU_REGISTER :> COMMIT_CSRFPU_REGISTER,

        CSR_RESULT <: CSR.result,
        CSR_DESTREG <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd,

        FPUFAST_CLS_READY <: FAST_CLS.COMMIT_RESULT_READY,

        FPUFAST_M2I_READY <: FAST_M2I.COMMIT_RESULT_READY,

        FPUFAST_CMP_READY <: FAST_CMP.COMMIT_RESULT_READY,

        FPUCONVERT_F2I_READY <: CONVERT_F2I.COMMIT_RESULT_READY,
        FPUCONVERT_F2I_RESULT <: CONVERT_F2I.COMMIT_RESULT,
        FPUCONVERT_F2I_DESTREG <: CONVERT_F2I.COMMIT_DESTREG
    );

    csrfpu_commit_f COMMIT_F(                                                                                                   // COMMIT TO FLOATING-POINT REGISTER
        RESULT_READY :> EXECUTE_CSRFPU_RESULT_F_READY,
        COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK <: COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK,
        COMMIT_CSRFPU_F_RESULT :> COMMIT_CSRFPU_F_RESULT,
        COMMIT_CSRFPU_F_REGISTER :> COMMIT_CSRFPU_F_REGISTER,

        FPUFAST_FLI_READY <: FAST_FLI.COMMIT_F_RESULT_READY,

        FPUFAST_M2F_READY <: FAST_M2F.COMMIT_F_RESULT_READY,

        FPUFAST_MNX_READY <: FAST_MNX.COMMIT_F_RESULT_READY,

        FPUFAST_SNJ_READY <: FAST_SNJ.COMMIT_F_RESULT_READY,

        FPUCONVERT_I2F_READY <: CONVERT_I2F.COMMIT_F_RESULT_READY,
        FPUCONVERT_I2F_RESULT <: CONVERT_I2F.COMMIT_RESULT,
        FPUCONVERT_I2F_DESTREG <: CONVERT_I2F.COMMIT_DESTREG,

        FPUCONVERT_CP_READY <: CONVERT_CP.COMMIT_F_RESULT_READY,
        FPUCONVERT_CP_RESULT <: CONVERT_CP.COMMIT_RESULT,
        FPUCONVERT_CP_DESTREG <: CONVERT_CP.COMMIT_DESTREG,

        FPUCONVERT_R_READY <: CONVERT_R.COMMIT_F_RESULT_READY,
        FPUCONVERT_R_RESULT <: CONVERT_R.COMMIT_RESULT,
        FPUCONVERT_R_DESTREG <: CONVERT_R.COMMIT_DESTREG,

        FPUCALC_FMA_READY <: CALC_FMA.COMMIT_RESULT_READY,
        FPUCALC_FMA_RESULT <: CALC_FMA.COMMIT_RESULT,
        FPUCALC_FMA_DESTREG <: CALC_FMA.COMMIT_DESTREG,

        FPUCALC_DIV_READY <: CALC_DIV.COMMIT_RESULT_READY,
        FPUCALC_DIV_RESULT <: CALC_DIV.COMMIT_RESULT,
        FPUCALC_DIV_DESTREG <: CALC_DIV.COMMIT_DESTREG,

        FPUCALC_SQRT_READY <: CALC_SQRT.COMMIT_RESULT_READY,
        FPUCALC_SQRT_RESULT <: CALC_SQRT.COMMIT_RESULT,
        FPUCALC_SQRT_DESTREG <: CALC_SQRT.COMMIT_DESTREG
    );

    repackage_actual DOMINMAX( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] );
    make_actual SIGNINJ( dsh <: Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], exp <: fp64( REPACK_F1.repack ).exponent, fraction <: fp64( REPACK_F1.repack ).fraction );

    DOMINMAX.a := |( TYPE_F1.type[1,2] | TYPE_F2.type[1,2] ) ? Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[1,1] ? 64h7FF8000000000000 :                     // FMINM FMAXM ANY NAN -> NAN
( TYPE_F1.type[2,1] | TYPE_F2.type[2,1] ) | ( TYPE_F1.type[1,1] & TYPE_F2.type[1,1] ) ? 64h7FF8000000000000 :                     // FMIN FMAX sNAN or BOTH qNAN -> NAN
                                                TYPE_F1.type[1,1] ? REPACK_F2.repack : REPACK_F1.repack :                                 //  A == NAN -> B, B == NAN -> A
                            ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[0,1] ^ FPUcompare.less ) ? REPACK_F1.repack : REPACK_F2.repack;                                  //  ELSE MIN/MAX AND SELECT REGISTER

    SIGNINJ.sign := ( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[1,1] ? fp64( REPACK_F1.repack ).sign : Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[0,1] ) ^ fp64( REPACK_F2.repack ).sign;                              // DETERMINE SIGN FOR INJECTION ^ FOR JX, ~ FOR JN = FOR J

    FPUcompare.F1_OR_F2_NAN := |( TYPE_F1.type[1,2] | TYPE_F2.type[1,2] );
    FPUcompare.F1_AND_F2_ZERO := ( TYPE_F1.type[0,1] & TYPE_F2.type[0,1] );

    CSR.START := STATE[1,1] &
                 FAST_CLS.READY & FAST_FLI.READY & FAST_M2I.READY & FAST_M2F.READY & FAST_SNJ.READY & FAST_CMP.READY & FAST_MNX.READY &
                 CONVERT_I2F.READY & CONVERT_F2I.READY & CONVERT_CP.READY & CONVERT_R.READY &
                 CALC_FMA.READY & CALC_DIV.READY & CALC_SQRT.READY;

    FAST_CLS.START := STATE[3,1] & FAST_CLS.READY & FAST_TYPE[6,1];
    FAST_FLI.START := STATE[3,1] & FAST_FLI.READY & FAST_TYPE[5,1];
    FAST_M2I.START := STATE[3,1] & FAST_M2I.READY & FAST_TYPE[4,1];
    FAST_M2F.START := STATE[3,1] & FAST_M2F.READY & FAST_TYPE[3,1];
    FAST_SNJ.START := STATE[3,1] & FAST_MNX.READY & FAST_TYPE[2,1];
    FAST_CMP.START := STATE[3,1] & FAST_MNX.READY & FAST_TYPE[1,1];
    FAST_MNX.START := STATE[3,1] & FAST_MNX.READY & FAST_TYPE[0,1];

    CONVERT_I2F.START := STATE[4,1] & CONVERT_I2F.READY & CNV_TYPE[1,1];
    CONVERT_F2I.START := STATE[4,1] & CONVERT_F2I.READY & CNV_TYPE[2,1];
    CONVERT_CP.START := STATE[4,1] & CONVERT_CP.READY & CNV_TYPE[0,1] & ~Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[2,1];
    CONVERT_R.START := STATE[4,1] & CONVERT_R.READY & CNV_TYPE[0,1] & Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[2,1];

    CALC_FMA.START := STATE[5,1] & CALC_FMA.READY & ( |ACTION[0,2] | ACTION[4,1] );
    CALC_DIV.START := STATE[5,1] & CALC_DIV.READY & ACTION[2,1];
    CALC_SQRT.START := STATE[5,1] & CALC_SQRT.READY & ACTION[3,1];

    COMMIT_I.CSR_READY := STATE[2,1];

    CSR.W_FPUFLAGS := COMMIT_I.FPUFAST_CMP_ACK | COMMIT_F.FPUFAST_MNX_ACK |                                                            // UPDATE CSR FLOATING POINT FLAGS
                      COMMIT_I.FPUCONVERT_F2I_ACK |
                      COMMIT_F.FPUCONVERT_I2F_ACK | COMMIT_F.FPUCONVERT_CP_ACK | COMMIT_F.FPUCONVERT_R_ACK |
                      COMMIT_F.FPUCALC_FMA_ACK | COMMIT_F.FPUCALC_DIV_ACK | COMMIT_F.FPUCALC_SQRT_ACK;
    CSR.IN_FPUFLAGS := CSR.OUT_FPUFLAGS | (                                                                                     // MERGE OLD AND NEW FLAGS
                                            ( COMMIT_I.FPUFAST_CMP_ACK ? FAST_CMP.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUFAST_MNX_ACK ? FAST_MNX.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_I.FPUCONVERT_F2I_ACK ? CONVERT_F2I.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUCONVERT_I2F_ACK ? CONVERT_I2F.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUCONVERT_CP_ACK ? CONVERT_CP.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUCONVERT_R_ACK ? CONVERT_R.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUCALC_FMA_ACK ? CALC_FMA.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUCALC_DIV_ACK ? CALC_DIV.OUT_FPUFLAGS : 0 ) |
                                            ( COMMIT_F.FPUCALC_SQRT_ACK ? CALC_SQRT.OUT_FPUFLAGS : 0 )
                                          );

    immediate_rom.addr := { Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2], Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr1 };             // SELECT IMMEDIATE VALUE

    always {
        uint64      RD = uninitialised;                                                                                         // REGISTER CONTENTION FLAG

        onehot( STATE ) {
            case 0: {
                RD = EXECUTE_CSRFPU_ACK << { $EX_CSRFPU_IS_WR_F$, Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd };                     // SET REGISTER CONTENTION FLAG
                if( EXECUTE_CSRFPU_ACK ) {                                                                                      // WAIT FOR AGU TO ACKNOWLEDGE INSTRUCTION IS READY
                    EXECUTE_CSRFPU_READY = 0;                                                                                   //  HALT AGU SENDING MORE INSTRUCTIONS
                    STATE =         $EX_CSRFPU_IS_CSR$ ? 2 :
                               $EX_CSRFPU_IS_FPU_FAST$ ? 8 :
                            $EX_CSRFPU_IS_FPU_CONVERT$ ? 16 :
                                                         32;
                }
            }

            case 1: { if( CSR.START ) { STATE = 4; } }                                                                          // CSR EXECUTE START ( when FPU units are idle )
            case 2: { if( COMMIT_I.CSR_ACK ) { STATE = 1; EXECUTE_CSRFPU_READY = 1; } }                                         // CSR COMMIT

            case 3: {                                                                                                           // FPU FAST
                onehot( FAST_TYPE ) {
                    case 0: { // FMIN FMAX
                        if( FAST_MNX.READY ) {
                            COMMIT_F.FPUFAST_MNX_RESULT = DOMINMAX.repack;
                            COMMIT_F.FPUFAST_MNX_DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            FAST_MNX.FLAGS = { |( TYPE_F1.type[1,2] | TYPE_F2.type[1,2] ), 4b0000 };                            // FLAGS SIGNALLING NAN INPUT
                            FAST_MNX.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 1: { // FEQ FLT FLE
                        if( FAST_CMP.READY ) {
                            COMMIT_I.FPUFAST_CMP_RESULT = ~|( TYPE_F1.type[1,2] | TYPE_F2.type[1,2] ) & FLTEQ[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3, 1 ];                                                   // FEQ FLT FLE 0 IF NAN ELSE COMPARISON FLAG
                            COMMIT_I.FPUFAST_CMP_DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            FAST_CMP.FLAGS = {                                                                                                // RETURN NV FLAG IF FLT OR FLE AND NAN IS AN INPUT
                        Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[2,1] ? 1b0 :
                        Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f3[1,1] ? ( TYPE_F1.type[2,1] | TYPE_F2.type[2,1] ) : |( TYPE_F1.type[1,2] | TYPE_F2.type[1,2] ),
                        4b0000
                    };
                            FAST_CMP.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 2: { // FSGNJ FSGNJN FSGNJX
                        if( FAST_SNJ.READY ) {
                            COMMIT_F.FPUFAST_SNJ_RESULT = SIGNINJ.repack;
                            COMMIT_F.FPUFAST_SNJ_DESTREG  = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            FAST_SNJ.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 3: { // FMV I->F
                        if( FAST_M2F.READY ) {
                            FAST_M2F.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            COMMIT_F.FPUFAST_M2F_RESULT = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,1] ? EXECUTE_CSRFPU_I1 :                                                                          // FMV.W.D
                     Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[1,1] ? { 48hffffffffffff, EXECUTE_CSRFPU_I1[0,16] } :                                                 // FMV.W.H
                                {     32hffffffff, EXECUTE_CSRFPU_I1[0,32] };                                                 // FMV.W.S :
                            COMMIT_F.FPUFAST_M2F_DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 4: { // FMV F-> I
                        if( FAST_M2I.READY ) {
                            FAST_M2I.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            COMMIT_I.FPUFAST_M2I_RESULT = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,1] ? REPACK_F1.repack :                                                                                            // FMV.D.W
                                                          Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[1,1] ? { {48{fp64( REPACK_F1.repack ).sign}}, fp64( REPACK_F1.repack ).exponent[0,5], fp64( REPACK_F1.repack ).fraction[42,10] } :               // FMV.H.W
                                                                     { {32{fp64( REPACK_F1.repack ).sign}}, fp64( REPACK_F1.repack ).exponent[0,8], fp64( REPACK_F1.repack ).fraction[29,23] };                // FMV.S.W
                            COMMIT_I.FPUFAST_M2I_DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 5: { // FLI
                        if( FAST_FLI.READY ) {
                            FAST_FLI.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            COMMIT_F.FPUFAST_FLI_RESULT = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,1] ? {                                                                   // EXTRACT DOUBLE IMMEDIATE
                                    immediate_rom.rdata[13, 1],
                                    immediate_rom.rdata[ 2,11],
                                    immediate_rom.rdata[ 0, 2],
                                    50h0
                                } :
                     Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[1,1] ? {                                                                   // EXTRACT HALF PRECISION IMMEDIATE
                                    48hffffffffffff,                                                //  NAN BOXED
                                    immediate_rom.rdata[ 7, 1],
                                    immediate_rom.rdata[ 2, 5],
                                    immediate_rom.rdata[ 0, 2],
                                    8h0
                                } :
                                {                                                                   // EXTRACT SINGLE PRECISION IMMEDIATE
                                32hffffffff,                                                    //  NAN BOXED
                                    immediate_rom.rdata[10, 1],
                                    immediate_rom.rdata[ 2, 8],
                                    immediate_rom.rdata[ 0, 2],
                                    21h0
                                };
                            COMMIT_F.FPUFAST_FLI_DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 6: { // FCLASS
                        if( FAST_CLS.READY ) {
                            FAST_CLS.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            COMMIT_I.FPUFAST_CLS_RESULT = {                                                                                         // FCLASS
                                                            TYPE_F1.type[1,1],                                                                          // 512  qNAN
                                                            TYPE_F1.type[2,1],                                                                          // 256  sNAN
                                                            TYPE_F1.type[3,1] & ~REPACK_F1.repack[63,1],                                                    // 128  +INF
                                                            ~|TYPE_F1.type & ~REPACK_F1.repack[63,1],                                                       // 64   +NORMAL
                                                            TYPE_F1.type[0,1] & ~REPACK_F1.repack[63,1] & ~TYPE_F1.type[4,1],                                   // 32   +SUBNORMAL
                                                            TYPE_F1.type[0,1] & ~REPACK_F1.repack[63,1] & TYPE_F1.type[4,1],                                    // 16   +0
                                                            TYPE_F1.type[0,1] & REPACK_F1.repack[63,1] & TYPE_F1.type[4,1],                                     // 8    -0
                                                            TYPE_F1.type[0,1] & REPACK_F1.repack[63,1] & ~TYPE_F1.type[4,1],                                    // 4    -SUBNORMAL
                                                            ~|TYPE_F1.type & REPACK_F1.repack[63,1],                                                        // 2    -NORMAL
                                                            TYPE_F1.type[3,1] & REPACK_F1.repack[63,1]                                                      // 1    -INF
                                                        };
                            COMMIT_I.FPUFAST_CLS_DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;

                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                }
            }

            case 4: {                                                                                                           // FPU CONVERT
                onehot( CNV_TYPE ) {
                    case 0: { // CP OR R
                        if( Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[2,1] ) {
                            if( CONVERT_R.READY ) {
                                CONVERT_R.RMODE = RMODE; CONVERT_R.MB = CNV_MB[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                                CONVERT_R.DBIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                                CONVERT_R.FUNCTION7 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2]; CONVERT_R.RS2 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,1];
                                CONVERT_R.F1 = EXECUTE_CSRFPU_F1; CONVERT_R.F1_X = REPACK_F1.repack; CONVERT_R.F1_TYPE = TYPE_F1.type;
                                CONVERT_R.EXP = CNV_EXP;

                                CONVERT_R.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                                STATE = 1; EXECUTE_CSRFPU_READY = 1;
                            }
                        } else {
                            if( CONVERT_CP.READY ) {
                                CONVERT_CP.RMODE = RMODE; CONVERT_CP.MB = CNV_MB[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                                CONVERT_CP.DBIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ]; CONVERT_CP.SBIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,2] ];
                                CONVERT_CP.FUNCTION7 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2]; CONVERT_CP.RS2 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,2];
                                CONVERT_CP.F1_CP = REPACK_CP.repack; CONVERT_CP.F1_TYPE_CP = TYPE_CP.type;

                                CONVERT_CP.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                                STATE = 1; EXECUTE_CSRFPU_READY = 1;
                            }
                        }
                    }
                    case 1: { // I2F
                        if( CONVERT_I2F.READY ) {
                            CONVERT_I2F.RMODE = RMODE; CONVERT_I2F.MB = CNV_MB[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CONVERT_I2F.DBIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CONVERT_I2F.FUNCTION7 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2]; CONVERT_I2F.RS2 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2[0,2];
                            CONVERT_I2F.I1 = EXECUTE_CSRFPU_I1; CONVERT_I2F.I1_ABS32 = EXECUTE_CSRFPU_I1_ABS32; CONVERT_I2F.I1_ABS64 = EXECUTE_CSRFPU_I1_ABS64;

                            CONVERT_I2F.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 2: { // F2I
                        if( CONVERT_F2I.READY ) {
                            CONVERT_F2I.RMODE = RMODE;
                            CONVERT_F2I.DBIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CONVERT_F2I.RS2 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).sr2;
                            CONVERT_F2I.F1 = EXECUTE_CSRFPU_F1; CONVERT_F2I.F1_X = REPACK_F1.repack; CONVERT_F2I.F1_TYPE = TYPE_F1.type;
                            CONVERT_F2I.EXP = CNV_EXP;

                            CONVERT_F2I.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                }
            }

            case 5: {                                                                                                           // FPU CALC
                onehot( ACTION ) {
                    default: {
                        if( CALC_FMA.READY ) {
                            CALC_FMA.ACTION = ACTION;
                            CALC_FMA.RMODE = RMODE;
                            CALC_FMA.dsh = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2]; CALC_FMA.BIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CALC_FMA.OPCODE = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).opp[2,5]; CALC_FMA.FUNCTION7 = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[2,5];
                            CALC_FMA.F1_X = REPACK_F1.repack; CALC_FMA.F1_TYPE = TYPE_F1.type;
                            CALC_FMA.F2_X = REPACK_F2.repack; CALC_FMA.F2_TYPE = TYPE_F2.type;
                            CALC_FMA.F3_X = REPACK_F3.repack; CALC_FMA.F3_TYPE = TYPE_F3.type;

                            CALC_FMA.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 2: {
                        if( CALC_DIV.READY ) {
                            CALC_DIV.RMODE = RMODE;
                            CALC_DIV.dsh = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2]; CALC_DIV.BIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CALC_DIV.F1_X = REPACK_F1.repack; CALC_DIV.F1_TYPE = TYPE_F1.type;
                            CALC_DIV.F2_X = REPACK_F2.repack; CALC_DIV.F2_TYPE = TYPE_F2.type;

                            CALC_DIV.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 3: {
                        if( CALC_SQRT.READY ) {
                            CALC_SQRT.RMODE = RMODE;
                            CALC_SQRT.dsh = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2]; CALC_SQRT.BIAS = BIAS_TABLE[ Rtype( EXECUTE_CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CALC_SQRT.F1_X = REPACK_F1.repack; CALC_SQRT.F1_TYPE = TYPE_F1.type;

                            CALC_SQRT.DESTREG = Rtype( EXECUTE_CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                }
            }
        }

        EXECUTE_CSRFPU_RD = RD | COMMIT_I.RD |
                            FAST_CLS.RD | FAST_M2I.RD | FAST_CMP.RD |
                            CONVERT_F2I.RD |
                            {
                                COMMIT_F.RD |
                                FAST_FLI.RD | FAST_M2F.RD | FAST_MNX.RD | FAST_SNJ.RD |
                                CONVERT_I2F.RD | CONVERT_CP.RD | CONVERT_R.RD |
                                CALC_FMA.RD | CALC_DIV.RD | CALC_SQRT.RD,
                                32h00000000
                            };

$$if VERILATOR then
        COMMITS[ CSR_INC_INSNRET & 3 ] = COMMITS[ CSR_INC_INSNRET & 3 ] + 1;
        COUNT = COUNT + 1;
        if( COUNT == 1000000 ) {
            COUNT = 0;
            __display( "[ 0 = %d ] [ 1 = %d ] [ 2 = %d ] [ 3 = %d ]",COMMITS[0],COMMITS[1],COMMITS[2],COMMITS[3] );
        }
$$end
        if( reset ) { RD = 0; EXECUTE_CSRFPU_READY = 1; STATE = 1; }
    }
}

unit fpufast_minmax_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,
    input   uint5               DESTREG,

    input   uint1               COMMIT_F_ACK,
    output  uint1               COMMIT_F_RESULT_READY,

    input   uint5               FLAGS,                                                                                          //  REPACKED INTO DOUBLE BIT FIELDS
    output  uint5               OUT_FPUFLAGS                                                                                   // NEW FPU FLAGS
) <reginputs> {
    uint3               STATE = 1;

    COMMIT_F_RESULT_READY := STATE[2,1];

    OUT_FPUFLAGS := FLAGS;                                                                                   // FLAGS SIGNALLING NAN INPUT :

    always {
        onehot( STATE ) {
            case 0: { RD[ DESTREG, 1 ] = START; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { if( COMMIT_F_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit fpufast_fsnj_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,
    input   uint5               DESTREG,

    input   uint1               COMMIT_F_ACK,
    output  uint1               COMMIT_F_RESULT_READY
) <reginputs> {
    uint3               STATE = 1;

    COMMIT_F_RESULT_READY := STATE[2,1];

    always {
        onehot( STATE ) {
            case 0: { RD[ DESTREG, 1 ] = START; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { if( COMMIT_F_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

