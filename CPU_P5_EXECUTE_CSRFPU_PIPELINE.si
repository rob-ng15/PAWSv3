    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,

    input   uint5               FLAGS,
    output  uint5               OUT_FPUFLAGS                                                                                    // NEW FPU FLAGS
) <reginputs> {
    uint3               STATE = 1;

    COMMIT_RESULT_READY := STATE[2,1];

    OUT_FPUFLAGS := FLAGS;

    always {
        onehot( STATE ) {
            case 0: { RD[ DESTREG, 1 ] = START; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

