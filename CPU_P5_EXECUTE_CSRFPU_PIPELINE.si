// CSRFPU_FLAGS = { STORE, LOAD, JUMP, FPU_FAST, FPU_CONVERT, FPU, FENCE, CSR, ATOMIC, ALU_SIGNX, ALU_FAST, ALU, WR_F, WR }
    $$ EX_CSRFPU_IS_WR =          "CSRFPU_FLAGS[ 0,1]"
    $$ EX_CSRFPU_IS_WR_F =        "CSRFPU_FLAGS[ 1,1]"
    $$ EX_CSRFPU_IS_CSR =         "CSRFPU_FLAGS[ 2,1]"
    $$ EX_CSRFPU_IS_FPU =         "CSRFPU_FLAGS[ 3,1]"
    $$ EX_CSRFPU_IS_FPU_CONVERT = "CSRFPU_FLAGS[ 4,1]"
    $$ EX_CSRFPU_IS_FPU_FAST =    "CSRFPU_FLAGS[ 5,1]"

unit cpu_execute_csrfpu(
    input   uint1               clock_decode,

    $$for i=1,3 do
    input   uint64              EXECUTE_CSRFPU_F$i$,                                                                            // FLOAT REGISTERS
    $$end
    input   uint64              EXECUTE_CSRFPU_I1,                                                                              // INTEGER REGISTER
    input   uint64              EXECUTE_CSRFPU_I1_ABS64,                                                                        // ABSOLUTE VALUE OF INTEGER REGISTER FOR CONVERSIONS
    input   uint32              EXECUTE_CSRFPU_I1_ABS32,

    output  uint1               EXECUTE_CSRFPU_READY,                                                                           // PIPELINE COMMUNICATION TO/FROM DISPATCH
    input   uint1               EXECUTE_CSRFPU_ACK,
    input   uint32              CSRFPU_INSTRUCTION,
    input   uint6               CSRFPU_FLAGS,

    output  uint1               EXECUTE_CSRFPU_RESULT_READY,                                                                    // PIPELINE COMMUNICATION TO INTEGER COMMIT
    input   uint1               COMMIT_EXECUTE_CSRFPU_RESULT_ACK,
    output  uint64              COMMIT_CSRFPU_RESULT,
    output  uint5               COMMIT_CSRFPU_REGISTER,

    output  uint1               EXECUTE_CSRFPU_RESULT_F_READY,                                                                  // PIPELINE COMMUNICATION TO FLOATING-POINT COMMIT
    input   uint1               COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK,
    output  uint64              COMMIT_CSRFPU_F_RESULT,
    output  uint5               COMMIT_CSRFPU_F_REGISTER,

    output  uint64              EXECUTE_CSRFPU_RD,                                                                              // REGISTER CONTENTION FLAG

    output  uint$addr_width$    CSR_MEPC,                                                                                       // CSR INTERRUPT FLAGS
    output  uint$addr_width$    CSR_MTVEC,
    output  uint1               CSR_IRQ_PENDING,
    output  uint4               CSR_IRQ_VECTOR,
    input   uint1               CSR_IRQ_ACK,
    output  uint1               CSR_IRQ_ACK_ACK,
    input   uint1               CSR_IRQ_END,
    output  uint1               CSR_IRQ_END_ACK,
    input   uint1               CSR_ECALL_REQ,
    input   uint$addr_width$    CSR_NEW_MEPC,
    input   uint$CWIDTH$        IRQ_TIMER,                                                                                      // IRQ TIMER TRIGGER VALUE
    input   uint1               TIMER_VALID,                                                                                    // HAS IRQ TIMER TRIGGER VALUE BEEN FULLY SET
    input   uint$CWIDTH$        RDTIME,
    input   uint1               IRQ_VBLANK,                                                                                     // IRQ VBLANK

    input   uint1               DMA_ACTIVE,                                                                                     // DMA AUDIO/COPY/SET IS ACTIVE

    input   uint3               CSR_INC_INSNRET                                                                                 // INSTRUCTION COMPLETION INCREMENT
) <reginputs> {
$$if VERILATOR then
    uint64  COMMITS[4] = { 0, 0, 0, 0 };
    uint24  COUNT = 0;
$$end

    uint6               STATE = 1;

    uint10              BIAS_TABLE[4] = { $BIAS32$, $BIAS64$, $BIAS16$, 10b1111111111 };                                        // BIAS FOR DIFFERENT PRECISIONS

    uint3               operation <:: {                                                                                         // PRESENT INSTRUCTION ROUTE
                                        ~( $EX_CSRFPU_IS_FPU_FAST$ | $EX_CSRFPU_IS_FPU_CONVERT$ ),
                                        $EX_CSRFPU_IS_FPU_CONVERT$,
                                        $EX_CSRFPU_IS_FPU_FAST$
                                      };

    uint5               ACTION <:: ( Rtype( CSRFPU_INSTRUCTION ).opp[2,5] == 5b10100 ) ?                                        // CALCULATION TYPE FLAG
                                       ( Rtype( CSRFPU_INSTRUCTION ).f7[2,2] == 2b10 ) ? 5b00010 :                              // IDENTIFY UNIT { fused, sqrt, div, mul, add }
                                       ( Rtype( CSRFPU_INSTRUCTION ).f7[2,2] == 2b11 ) ?                                        //                 4      3     2    1    0
                                                { 1b0, Rtype( CSRFPU_INSTRUCTION ).f7[5,1], ~Rtype( CSRFPU_INSTRUCTION ).f7[5,1], 2b00 } :
                                                                                         5b00001 :
                                                                                         5b10000;

    uint3               CNV_TYPE <:: {                                                                                          // CONVERSION TYPE FLAG
                                        ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b11000 ),                                     // FD2IL
                                        ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b11010 ),                                     // IL2FD
                                        ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b01000 )                                      // CHANGE PRECISION HSD <-> HSD, FROUND IF RS2[2,1]
                                     };

    uint7   FAST_TYPE <:: {                                                                                                     // FAST TYPE FLAG
                            ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b11100 ) & Rtype( CSRFPU_INSTRUCTION ).f3[0,1],           // FCLASS
                            ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b11110 ) & Rtype( CSRFPU_INSTRUCTION ).sr2[0,1],          // FLI
                            ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b11100 ) & ~Rtype( CSRFPU_INSTRUCTION ).f3[0,1],          // FMV F -> I
                            ( Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b11110 ) & ~Rtype( CSRFPU_INSTRUCTION ).sr2[0,1],         // FMV I -> F
                            Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b00100,                                                     // FSGNJ FSGNJN FSGNJX
                            Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b10100,                                                     // FEQ FLT FLE
                            Rtype( CSRFPU_INSTRUCTION ).f7[2,5] == 5b00101                                                      // FMIN FMAX
                          };

    uint6               CNV_MB[4] = { 29, 0, 42, -1 };                                                                          // SHIFT AMOUNT FOR ROUNDING BIT POSITION
    int13               CNV_EXP <:: fp64( REPACK_F1.repack ).exponent -                                                         // EXTRACT EXPONENT AND REMOVE BIAS
                                    BIAS_TABLE[ Rtype( CSRFPU_INSTRUCTION ).f7[0,2] ];


    uint2               RMODE <:: &Rtype( CSRFPU_INSTRUCTION ).f3 ? CSR.OUT_FPUFLAGS[5,2] :                                     // ROUNDING MODE FROM INSTRUCTION OR FRM
                                                                    Rtype( CSRFPU_INSTRUCTION ).f3[0,2];

    typeF TYPE_F1 <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F1 );                       // CLASSIFY F1 { ZF, INF, sNAN, qNAN, ZERO }
    typeF TYPE_F2 <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F2 );                       // CLASSIFY F2 { ZF, INF, sNAN, qNAN, ZERO }
    typeF TYPE_F3 <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F3 );                       // CLASSIFY F3 { ZF, INF, sNAN, qNAN, ZERO }
    typeF TYPE_CP <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).sr2[0,2], a <: EXECUTE_CSRFPU_F1 );                      // FORCE CLASSIFICATION FOR changeprecision
    repackage_wide REPACK_F1 <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F1 );            // PACK F1 FIELDS INTO BITFIELDS OF DOUBLE-PRECISION
    repackage_wide REPACK_F2 <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F2 );            // PACK F2 FIELDS INTO BITFIELDS OF DOUBLE-PRECISION
    repackage_wide REPACK_F3 <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).f7[0,2], a <: EXECUTE_CSRFPU_F3 );            // PACK F3 FIELDS INTO BITFIELDS OF DOUBLE-PRECISION
    repackage_wide REPACK_CP <@clock_decode> ( dsh <: Rtype( CSRFPU_INSTRUCTION ).sr2[0,2], a <: EXECUTE_CSRFPU_F1 );           // changeprecision SIGN, EXPONENT (with bias), FRACTION

    floatcompare FPUcompare <@clock_decode> (                                                                                   // FLOATING POINT COMPARISONS
        a <: REPACK_F1.repack, b <: REPACK_F2.repack,                                                                           // PASS REPACKED VALUES TO COMPARE
        F1_ZERO_FRACTION <: TYPE_F1.type[4,1],                                                                                  // A FRACTION 0?
        F2_ZERO_FRACTION <: TYPE_F2.type[4,1]                                                                                   // B FRACTION 0?
    );

    CSRblock CSR(                                                                                                               // RISC-V CSR REGISTERS + INTERRUPT CONTROLLER
        INC_INSNRET <: CSR_INC_INSNRET,                                                                                         // INSTRUCTION RETIRED FLAGS
        DMA_ACTIVE <: DMA_ACTIVE,                                                                                               // FOR PERFORMANCE COUNTERS
        PC_NEXT <: CSR_NEW_MEPC,                                                                                                // NEXT INSTRUCTION FOR MEPC
        RDTIME <: RDTIME, IRQ_VBLANK <: IRQ_VBLANK, IRQ_TIMER <: IRQ_TIMER, TIMER_VALID <: TIMER_VALID,                         // HARDWARE IRQ FLAGS
        CSR_ECALL_REQ <: CSR_ECALL_REQ,                                                                                         // SOFTWARE IRQ FLAG
        CSR_MEPC :> CSR_MEPC, CSR_MTVEC :> CSR_MTVEC,                                                                           //  TO/FROM FETCH IRQ CONTROL SIGNALS
        IRQ_PENDING :> CSR_IRQ_PENDING, IRQ_VECTOR :> CSR_IRQ_VECTOR,
        IRQ_ACK <: CSR_IRQ_ACK, IRQ_ACK_ACK :> CSR_IRQ_ACK_ACK, IRQ_END <: CSR_IRQ_END, IRQ_END_ACK :> CSR_IRQ_END_ACK,         // CS[R][W] INSTRUCTION FLAGS AND VALUES
        function3 <: CSR( CSRFPU_INSTRUCTION ).f3, rs1 <: CSR( CSRFPU_INSTRUCTION ).sr1,
        CSR_REG <: CSR( CSRFPU_INSTRUCTION ).csr, sourceReg1 <: EXECUTE_CSRFPU_I1
    );

    fpufast_execute FAST( COMMIT_ACK <: COMMIT_I.FPUFAST_ACK, COMMIT_F_ACK <: COMMIT_F.FPUFAST_ACK );
    fpuconvert_execute CONVERT( COMMIT_ACK <: COMMIT_I.FPUCONVERT_ACK, COMMIT_F_ACK <: COMMIT_F.FPUCONVERT_ACK );
    fpucalc_fma_execute CALC_FMA( COMMIT_ACK <: COMMIT_F.FPUCALC_FMA_ACK );                                                     //                          + - * AND FUSED
    fpucalc_div_execute CALC_DIV( COMMIT_ACK <: COMMIT_F.FPUCALC_DIV_ACK );                                                     //                          /
    fpucalc_sqrt_execute CALC_SQRT( COMMIT_ACK <: COMMIT_F.FPUCALC_SQRT_ACK );                                                  //                          SQUARE ROOT

    csrfpu_commit_i COMMIT_I(                                                                                                   // COMMIT TO INTEGR REGISTER
        RESULT_READY :> EXECUTE_CSRFPU_RESULT_READY,
        COMMIT_EXECUTE_CSRFPU_RESULT_ACK <: COMMIT_EXECUTE_CSRFPU_RESULT_ACK,
        COMMIT_CSRFPU_RESULT :> COMMIT_CSRFPU_RESULT,
        COMMIT_CSRFPU_REGISTER :> COMMIT_CSRFPU_REGISTER,

        CSR_RESULT <: CSR.result,
        CSR_DESTREG <: Rtype( CSRFPU_INSTRUCTION ).rd,

        FPUFAST_READY <: FAST.COMMIT_RESULT_READY,
        FPUFAST_RESULT <: FAST.COMMIT_RESULT,
        FPUFAST_DESTREG <: FAST.COMMIT_DESTREG,

        FPUCONVERT_READY <: CONVERT.COMMIT_RESULT_READY,
        FPUCONVERT_RESULT <: CONVERT.COMMIT_RESULT,
        FPUCONVERT_DESTREG <: CONVERT.COMMIT_DESTREG
    );

    csrfpu_commit_f COMMIT_F(                                                                                                   // COMMIT TO FLOATING-POINT REGISTER
        RESULT_READY :> EXECUTE_CSRFPU_RESULT_F_READY,
        COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK <: COMMIT_F_EXECUTE_CSRFPU_RESULT_F_ACK,
        COMMIT_CSRFPU_F_RESULT :> COMMIT_CSRFPU_F_RESULT,
        COMMIT_CSRFPU_F_REGISTER :> COMMIT_CSRFPU_F_REGISTER,

        FPUFAST_READY <: FAST.COMMIT_F_RESULT_READY,
        FPUFAST_RESULT <: FAST.COMMIT_RESULT,
        FPUFAST_DESTREG <: FAST.COMMIT_DESTREG,

        FPUCONVERT_READY <: CONVERT.COMMIT_F_RESULT_READY,
        FPUCONVERT_RESULT <: CONVERT.COMMIT_RESULT,
        FPUCONVERT_DESTREG <: CONVERT.COMMIT_DESTREG,

        FPUCALC_FMA_READY <: CALC_FMA.COMMIT_RESULT_READY,
        FPUCALC_FMA_RESULT <: CALC_FMA.COMMIT_RESULT,
        FPUCALC_FMA_DESTREG <: CALC_FMA.COMMIT_DESTREG,

        FPUCALC_DIV_READY <: CALC_DIV.COMMIT_RESULT_READY,
        FPUCALC_DIV_RESULT <: CALC_DIV.COMMIT_RESULT,
        FPUCALC_DIV_DESTREG <: CALC_DIV.COMMIT_DESTREG,

        FPUCALC_SQRT_READY <: CALC_SQRT.COMMIT_RESULT_READY,
        FPUCALC_SQRT_RESULT <: CALC_SQRT.COMMIT_RESULT,
        FPUCALC_SQRT_DESTREG <: CALC_SQRT.COMMIT_DESTREG
    );

    FPUcompare.F1_OR_F2_NAN := |( TYPE_F1.type[1,2] | TYPE_F2.type[1,2] );
    FPUcompare.F1_AND_F2_ZERO := ( TYPE_F1.type[0,1] & TYPE_F2.type[0,1] );

    CSR.START := STATE[1,1] & FAST.READY & CONVERT.READY & CALC_FMA.READY & CALC_DIV.READY & CALC_SQRT.READY;
    CONVERT.START := STATE[4,1] & CONVERT.READY;
    FAST.START := STATE[3,1] & FAST.READY;
    CALC_FMA.START := STATE[5,1] & CALC_FMA.READY & ( |ACTION[0,2] | ACTION[4,1] );
    CALC_DIV.START := STATE[5,1] & CALC_DIV.READY & ACTION[2,1];
    CALC_SQRT.START := STATE[5,1] & CALC_SQRT.READY & ACTION[3,1];

    COMMIT_I.CSR_READY := STATE[2,1];

    CSR.W_FPUFLAGS := COMMIT_I.FPUFAST_ACK | COMMIT_F.FPUFAST_ACK |
                      COMMIT_I.FPUCONVERT_ACK | COMMIT_F.FPUCONVERT_ACK |
                      COMMIT_F.FPUCALC_FMA_ACK | COMMIT_F.FPUCALC_DIV_ACK | COMMIT_F.FPUCALC_SQRT_ACK;

    CSR.IN_FPUFLAGS := CSR.OUT_FPUFLAGS | (
                            ( ( COMMIT_I.FPUFAST_ACK | COMMIT_F.FPUFAST_ACK ) ? FAST.OUT_FPUFLAGS : 0 ) |
                            ( ( COMMIT_I.FPUCONVERT_ACK | COMMIT_F.FPUCONVERT_ACK ) ? CONVERT.OUT_FPUFLAGS : 0 ) |
                            ( COMMIT_F.FPUCALC_FMA_ACK ? CALC_FMA.OUT_FPUFLAGS : 0 ) |
                            ( COMMIT_F.FPUCALC_DIV_ACK ? CALC_DIV.OUT_FPUFLAGS : 0 ) |
                            ( COMMIT_F.FPUCALC_SQRT_ACK ? CALC_SQRT.OUT_FPUFLAGS : 0 )
    );

    always {
        uint64      RD = uninitialised;                                                                                         // REGISTER CONTENTION FLAG

        onehot( STATE ) {
            case 0: {
                RD = EXECUTE_CSRFPU_ACK << { $EX_CSRFPU_IS_WR_F$, Rtype( CSRFPU_INSTRUCTION ).rd };                             // SET REGISTER CONTENTION FLAG
                if( EXECUTE_CSRFPU_ACK ) {                                                                                      // WAIT FOR AGU TO ACKNOWLEDGE INSTRUCTION IS READY
                    EXECUTE_CSRFPU_READY = 0;                                                                                   //  HALT AGU SENDING MORE INSTRUCTIONS
                    STATE =         $EX_CSRFPU_IS_CSR$ ? 2 :
                               $EX_CSRFPU_IS_FPU_FAST$ ? 8 :
                            $EX_CSRFPU_IS_FPU_CONVERT$ ? 16 :
                                                         32;
                }
            }

            case 1: { if( CSR.START ) { STATE = 4; } }                                                                          // CSR EXECUTE START ( when FPU units are idle )
            case 2: { if( COMMIT_I.CSR_ACK ) { STATE = 1; EXECUTE_CSRFPU_READY = 1; } }                                         // CSR COMMIT

            case 3: {                                                                                                           // FPU FAST
                if( FAST.READY ) {
                    FAST.dsh = Rtype( CSRFPU_INSTRUCTION ).f7[0,2];
                    FAST.FUNCTION3 = Rtype( CSRFPU_INSTRUCTION ).f3;
                    FAST.FUNCTION7 = Rtype( CSRFPU_INSTRUCTION ).f7[2,5];
                    FAST.RS1 = Rtype( CSRFPU_INSTRUCTION ).sr1;
                    FAST.RS2 = Rtype( CSRFPU_INSTRUCTION ).sr2;
                    FAST.I1 = EXECUTE_CSRFPU_I1;
                    FAST.F1_X = REPACK_F1.repack; FAST.F1_TYPE = TYPE_F1.type;
                    FAST.F2_X = REPACK_F2.repack; FAST.F2_TYPE = TYPE_F2.type;
                    FAST.FLT = FPUcompare.less;
                    FAST.FEQ = FPUcompare.equal;

                    FAST.WR_F = $EX_CSRFPU_IS_WR_F$; FAST.DESTREG = Rtype( CSRFPU_INSTRUCTION ).rd;

                    STATE = 1; EXECUTE_CSRFPU_READY = 1;
                }
            }

            case 4: {                                                                                                           // FPU CONVERT
                if( CONVERT.READY ) {
                    CONVERT.RMODE = RMODE;
                    CONVERT.DBIAS = BIAS_TABLE[ Rtype( CSRFPU_INSTRUCTION ).f7[0,2] ]; CONVERT.SBIAS = BIAS_TABLE[ Rtype( CSRFPU_INSTRUCTION ).sr2[0,2] ];
                    CONVERT.FUNCTION7 = Rtype( CSRFPU_INSTRUCTION ).f7; CONVERT.RS2 = Rtype( CSRFPU_INSTRUCTION ).sr2;
                    CONVERT.I1 = EXECUTE_CSRFPU_I1; CONVERT.I1_ABS32 = EXECUTE_CSRFPU_I1_ABS32; CONVERT.I1_ABS64 = EXECUTE_CSRFPU_I1_ABS64;
                    CONVERT.F1 = EXECUTE_CSRFPU_F1; CONVERT.F1_X = REPACK_F1.repack; CONVERT.F1_TYPE = TYPE_F1.type;
                    CONVERT.F1_CP = REPACK_CP.repack; CONVERT.F1_TYPE_CP = TYPE_CP.type;

                    CONVERT.WR_F = $EX_CSRFPU_IS_WR_F$; CONVERT.DESTREG = Rtype( CSRFPU_INSTRUCTION ).rd;

                    STATE = 1; EXECUTE_CSRFPU_READY = 1;
                }
            }

            case 5: {                                                                                                           // FPU CALC (Combined FMA, DIV, SQRT)
                onehot( ACTION ) {
                    default: {
                        if( CALC_FMA.READY ) {
                            CALC_FMA.ACTION = ACTION;
                            CALC_FMA.RMODE = RMODE;
                            CALC_FMA.dsh = Rtype( CSRFPU_INSTRUCTION ).f7[0,2]; CALC_FMA.BIAS = BIAS_TABLE[ Rtype( CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CALC_FMA.OPCODE = Rtype( CSRFPU_INSTRUCTION ).opp[2,5]; CALC_FMA.FUNCTION7 = Rtype( CSRFPU_INSTRUCTION ).f7[2,5];
                            CALC_FMA.F1_X = REPACK_F1.repack; CALC_FMA.F1_TYPE = TYPE_F1.type;
                            CALC_FMA.F2_X = REPACK_F2.repack; CALC_FMA.F2_TYPE = TYPE_F2.type;
                            CALC_FMA.F3_X = REPACK_F3.repack; CALC_FMA.F3_TYPE = TYPE_F3.type;

                            CALC_FMA.DESTREG = Rtype( CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 2: {
                        if( CALC_DIV.READY ) {
                            CALC_DIV.RMODE = RMODE;
                            CALC_DIV.dsh = Rtype( CSRFPU_INSTRUCTION ).f7[0,2]; CALC_DIV.BIAS = BIAS_TABLE[ Rtype( CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CALC_DIV.F1_X = REPACK_F1.repack; CALC_DIV.F1_TYPE = TYPE_F1.type;
                            CALC_DIV.F2_X = REPACK_F2.repack; CALC_DIV.F2_TYPE = TYPE_F2.type;

                            CALC_DIV.DESTREG = Rtype( CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                    case 3: {
                        if( CALC_SQRT.READY ) {
                            CALC_SQRT.RMODE = RMODE;
                            CALC_SQRT.dsh = Rtype( CSRFPU_INSTRUCTION ).f7[0,2]; CALC_SQRT.BIAS = BIAS_TABLE[ Rtype( CSRFPU_INSTRUCTION ).f7[0,2] ];
                            CALC_SQRT.F1_X = REPACK_F1.repack; CALC_SQRT.F1_TYPE = TYPE_F1.type;

                            CALC_SQRT.DESTREG = Rtype( CSRFPU_INSTRUCTION ).rd;
                            STATE = 1; EXECUTE_CSRFPU_READY = 1;
                        }
                    }
                }
            }
        }

        EXECUTE_CSRFPU_RD = RD | COMMIT_I.RD | FAST.RD | CONVERT.RD | { COMMIT_F.RD | CALC_FMA.RD | CALC_DIV.RD | CALC_SQRT.RD, 32h00000000 };

$$if VERILATOR then
        COMMITS[ CSR_INC_INSNRET & 3 ] = COMMITS[ CSR_INC_INSNRET & 3 ] + 1;
        COUNT = COUNT + 1;
        if( COUNT == 1000000 ) {
            COUNT = 0;
            __display( "[ 0 = %d ] [ 1 = %d ] [ 2 = %d ] [ 3 = %d ]",COMMITS[0],COMMITS[1],COMMITS[2],COMMITS[3] );
        }
$$end
        if( reset ) { RD = 0; EXECUTE_CSRFPU_READY = 1; STATE = 1; }
    }
}

unit fpufast_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint64              RD,
    input   uint1               WR_F,
    input   uint5               DESTREG,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    input   uint1               COMMIT_F_ACK,
    output  uint1               COMMIT_F_RESULT_READY,

    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG,

    input   uint2               dsh,                                                                                            // DOUBLE/SINGLE/HALF FLAG
    input   uint3               FUNCTION3,                                                                                      // SWITCH FOR COMPARE MINMAX AND SIGN OPERATIONS
    input   uint5               FUNCTION7,                                                                                      // SWITCH TO DETERMINE WHICH OPERATIONS
    input   uint5               RS1,
    input   uint5               RS2,
    input   uint64              I1,                                                                                             // INTEGER REGISTER FOR FMV
    input   uint64              F1_X,                                                                                           //  REPACKED INTO DOUBLE BIT FIELDS
    input   uint64              F2_X,
    input   uint5               F1_TYPE,                                                                                        // { INF sNAN qNAN ZERO } OF INPUT FLOAT REGISTER 1
    input   uint5               F2_TYPE,                                                                                        // { INF sNAN qNAN ZERO } OF INPUT FLOAT REGISTER 2
    input   uint1               FLT,                                                                                            // F1 < F2
    input   uint1               FEQ,                                                                                            // F1 == F2
    output  uint5               OUT_FPUFLAGS,                                                                                   // NEW FPU FLAGS
    output  uint64              RESULT                                                                                          // RESULT ( NAN boxed )
) <reginputs> {
    uint4               STATE = 1;

    uint1               f7_32_00 <:: ~|FUNCTION7[3,2];
    uint1               f7_32_10 <:: ( FUNCTION7[3,2] == 2b10 );

    uint10              FCLASS <:: {
                                        F1_TYPE[1,1],                                                                           // 512  qNAN
                                        F1_TYPE[2,1],                                                                           // 256  sNAN
                                        F1_TYPE[3,1] & ~fp64( F1_X ).sign,                                                      // 128  +INF
                                        ~|F1_TYPE & ~fp64( F1_X ).sign,                                                         // 64   +NORMAL
                                        F1_TYPE[0,1] & ~fp64( F1_X ).sign & ~F1_TYPE[4,1],                                      // 32   +SUBNORMAL
                                        F1_TYPE[0,1] & ~fp64( F1_X ).sign & F1_TYPE[4,1],                                       // 16   +0
                                        F1_TYPE[0,1] & fp64( F1_X ).sign & F1_TYPE[4,1],                                        // 8    -0
                                        F1_TYPE[0,1] & fp64( F1_X ).sign & ~F1_TYPE[4,1],                                       // 4    -SUBNORMAL
                                        ~|F1_TYPE & fp64( F1_X ).sign,                                                          // 2    -NORMAL
                                        F1_TYPE[3,1] & fp64( F1_X ).sign                                                        // 1    -INF
                                   };

    uint1               F1_OR_F2_NAN <:: |( F1_TYPE[1,2] | F2_TYPE[1,2] );
    uint3               LTEQ <:: { FEQ, FLT, FLT | FEQ };                                                                       // BIT ARRAY FOR COMPARISON FLAGS
    uint1               COMPARE <:: ~F1_OR_F2_NAN & LTEQ[ FUNCTION3, 1 ];                                                       // 0 IF NAN ELSE COMPARISON FLAG
    uint5               COMPARE_FLAGS <:: {                                                                                     // RETURN NV FLAG IF FLT OR FLE AND NAN IS AN INPUT
                                            FUNCTION3[2,1] ? 1b0 :
                                            FUNCTION3[1,1] ? ( F1_TYPE[2,1] | F2_TYPE[2,1] ) : F1_OR_F2_NAN,
                                            4b0000
                                          };

    uint64              MINMAX_RESULT <:: F1_OR_F2_NAN ?                  FUNCTION3[1,1] ? 64h7FF8000000000000 :                // FMINM FMAXM ANY NAN -> NAN
                                                         ( F1_TYPE[2,1] | F2_TYPE[2,1] ) |                                      // FMIN FMAX sNAN or BOTH qNAN -> NAN
                                                         ( F1_TYPE[1,1] & F2_TYPE[1,1] ) ? 64h7FF8000000000000 :
                                                                            F1_TYPE[1,1] ? F2_X : F1_X :                        //  A == NAN -> B, B == NAN -> A
                                                                ( FUNCTION3[0,1] ^ FLT ) ? F1_X : F2_X;                         //  ELSE MIN/MAX AND SELECT REGISTER
    repackage_actual DOMINMAX( dsh <: dsh, a <: MINMAX_RESULT );
    uint5               MINMAX_FLAGS <:: { F1_OR_F2_NAN, 4b0000 };                                                              // FLAGS SIGNALLING NAN INPUT

    uint1               SIGNINJ_SIGN <:: ( FUNCTION3[1,1] ? fp64( F1_X ).sign : FUNCTION3[0,1] ) ^ fp64( F2_X ).sign;           // DETERMINE SIGN FOR INJECTION
    make_actual SIGNINJ( dsh <: dsh, sign <: SIGNINJ_SIGN, exp <: fp64( F1_X ).exponent, fraction <: fp64( F1_X ).fraction );

    uint64              FMV_INT <:: dsh[0,1] ? I1 :                                                                             // FMV.W.D
                                    dsh[1,1] ? { 48hffffffffffff, I1[0,16] } :                                                  // FMV.W.H
                                               {     32hffffffff, I1[0,32] };                                                   // FMV.W.S
    uint64              FMV_FP <::  dsh[0,1] ? F1_X :                                                                           // FMV.D.W
                                    dsh[1,1] ? { {48{fp64( F1_X ).sign}},                                                       // FMV.H.W
                                                 fp64( F1_X ).exponent[0,5], fp64( F1_X ).fraction[42,10] } :
                                               { {32{fp64( F1_X ).sign}},                                                       // FMV.S.W
                                                 fp64( F1_X ).exponent[0,8], fp64( F1_X ).fraction[29,23] };

    brom uint14 immediate_rom[96] = {
                                                                                                                                // { 1b sign, 8b exponent, 2b msb of mantissa }
        11b10111111100,                                                                                                         // -1.0
        11b00000000100,                                                                                                         // minimum positive normal
        11b00110111100,                                                                                                         // 1 x 2^-16
        11b00111000000,                                                                                                         // 1 x 2^-15
        11b00111011100,                                                                                                         // 1 x 2^-8
        11b00111100000,                                                                                                         // 1 x 2^-7
        11b00111101100,                                                                                                         // 0.0625
        11b00111110000,                                                                                                         // 0.125
        11b00111110100,                                                                                                         // 0.25
        11b00111110101,                                                                                                         // 0.3125
        11b00111110110,                                                                                                         // 0.375
        11b00111110111,                                                                                                         // 0.4375
        11b00111111000,                                                                                                         // 0.5
        11b00111111001,                                                                                                         // 0.625
        11b00111111010,                                                                                                         // 0.75
        11b00111111011,                                                                                                         // 0.875
        11b00111111100,                                                                                                         // 1.0
        11b00111111101,                                                                                                         // 1.25
        11b00111111110,                                                                                                         // 1.5
        11b00111111111,                                                                                                         // 1.75
        11b01000000000,                                                                                                         // 2.0
        11b01000000001,                                                                                                         // 2.5
        11b01000000010,                                                                                                         // 3.0
        11b01000000100,                                                                                                         // 4.0
        11b01000001000,                                                                                                         // 8.0
        11b01000001100,                                                                                                         // 16.0
        11b01000011000,                                                                                                         // 128 2^7
        11b01000011100,                                                                                                         // 256 2^8
        11b01000111000,                                                                                                         // 2^15
        11b01000111100,                                                                                                         // 2^16
        11b01111111100,                                                                                                         // +INF
        11b01111111110,                                                                                                         // NaN

                                                                                                                                // { 1b sign, 11b exponent, 2b msb of mantissa }
        14b10111111111100,                                                                                                      // -1.0
        14b00000000000100,                                                                                                      // minimum positive normal
        14b00111110111100,                                                                                                      // 1 x 2^-16
        14b00111111000000,                                                                                                      // 1 x 2^-15
        14b00111111011100,                                                                                                      // 1 x 2^-8
        14b00111111100000,                                                                                                      // 1 x 2^-7
        14b00111111101100,                                                                                                      // 0.0625
        14b00111111110000,                                                                                                      // 0.125
        14b00111111110100,                                                                                                      // 0.25
        14b00111111110101,                                                                                                      // 0.3125
        14b00111111110110,                                                                                                      // 0.375
        14b00111111110111,                                                                                                      // 0.4375
        14b00111111111000,                                                                                                      // 0.5
        14b00111111111001,                                                                                                      // 0.625
        14b00111111111010,                                                                                                      // 0.75
        14b00111111111011,                                                                                                      // 0.875
        14b00111111111100,                                                                                                      // 1.0
        14b00111111111101,                                                                                                      // 1.25
        14b00111111111110,                                                                                                      // 1.5
        14b00111111111111,                                                                                                      // 1.75
        14b01000000000000,                                                                                                      // 2.0
        14b01000000000001,                                                                                                      // 2.5
        14b01000000000010,                                                                                                      // 3.0
        14b01000000000100,                                                                                                      // 4.0
        14b01000000001000,                                                                                                      // 8.0
        14b01000000001100,                                                                                                      // 16.0
        14b01000000011000,                                                                                                      // 128 2^7
        14b01000000011100,                                                                                                      // 256 2^8
        14b01000000111000,                                                                                                      // 2^15
        14b01000000111100,                                                                                                      // 2^16
        14b01111111111100,                                                                                                      // +INF
        14b01111111111110,                                                                                                      // NaN

                                                                                                                                // { 1b sign, 5b exponent, 2b msb of mantissa }
        8b10111100,                                                                                                             // -1.0
        8b00000100,                                                                                                             // minimum positive normal
        8b00000000,                                                                                                             // 1 x 2^-16 ( subnormal -> 0 )
        8b00000000,                                                                                                             // 1 x 2^-15 ( subnormal -> 0 )
        8b00011100,                                                                                                             // 1 x 2^-8
        8b00100000,                                                                                                             // 1 x 2^-7
        8b00101100,                                                                                                             // 0.0625
        8b00110000,                                                                                                             // 0.125
        8b00110100,                                                                                                             // 0.25
        8b00110101,                                                                                                             // 0.3125
        8b00110110,                                                                                                             // 0.375
        8b00110111,                                                                                                             // 0.4375
        8b00111000,                                                                                                             // 0.5
        8b00111001,                                                                                                             // 0.625
        8b00111010,                                                                                                             // 0.75
        8b00111011,                                                                                                             // 0.875
        8b00111100,                                                                                                             // 1.0
        8b00111101,                                                                                                             // 1.25
        8b00111110,                                                                                                             // 1.5
        8b00111111,                                                                                                             // 1.75
        8b01000000,                                                                                                             // 2.0
        8b01000001,                                                                                                             // 2.5
        8b01000010,                                                                                                             // 3.0
        8b01000100,                                                                                                             // 4.0
        8b01001000,                                                                                                             // 8.0
        8b01001100,                                                                                                             // 16.0
        8b01011000,                                                                                                             // 128 2^7
        8b01100100,                                                                                                             // 256 2^8
        8b01111000,                                                                                                             // 2^15
        8b01111100,                                                                                                             // +INF
        8b01111100,                                                                                                             // +INF
        8b01111110                                                                                                              // NaN
    };

    immediate_rom.addr := { dsh, RS1 };                                                                                         // SELECT IMMEDIATE VALUE

    COMMIT_RESULT_READY := STATE[3,1] & ~WR_F; COMMIT_F_RESULT_READY := STATE[3,1] & WR_F;
    COMMIT_DESTREG := DESTREG;

    COMMIT_RESULT :=       f7_32_00 ? FUNCTION7[0,1] ? DOMINMAX.repack : SIGNINJ.repack :                                       // FMIN FMAX FSGNJ FSGNJN FSGNJX
                           f7_32_10 ? COMPARE :                                                                                 // FEQ FLT FLE
                     FUNCTION7[1,1] ? RS2[0,1] ? dsh[0,1] ? {                                                                   // EXTRACT DOUBLE IMMEDIATE
                                                                immediate_rom.rdata[13, 1],
                                                                immediate_rom.rdata[ 2,11],
                                                                immediate_rom.rdata[ 0, 2],
                                                                50h0
                                                            } :
                                                 dsh[1,1] ? {                                                                   // EXTRACT HALF PRECISION IMMEDIATE
                                                                48hffffffffffff,                                                //  NAN BOXED
                                                                immediate_rom.rdata[ 7, 1],
                                                                immediate_rom.rdata[ 2, 5],
                                                                immediate_rom.rdata[ 0, 2],
                                                                8h0
                                                            } :
                                                            {                                                                   // EXTRACT SINGLE PRECISION IMMEDIATE
                                                                32hffffffff,                                                    //  NAN BOXED
                                                                immediate_rom.rdata[10, 1],
                                                                immediate_rom.rdata[ 2, 8],
                                                                immediate_rom.rdata[ 0, 2],
                                                                21h0
                                                            } :
                                      FMV_INT :                                                                                 // FMV.W.[DHS]
                     FUNCTION3[0,1] ? FCLASS :                                                                                  // FCLASS
                                      FMV_FP;                                                                                   // FMV.[DHS].W

    OUT_FPUFLAGS := f7_32_00 ? FUNCTION7[0,1] ? MINMAX_FLAGS : 0 :
                    f7_32_10 ? COMPARE_FLAGS :
                               0;

    always {
        onehot( STATE ) {
            case 0: { RD = START << { WR_F, DESTREG }; if( START ) { READY = 0; STATE = 2;} }
            case 1: { STATE = 4; }
            case 2: { STATE = 8; }
            case 3: { if( COMMIT_ACK | COMMIT_F_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit fpuconvert_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint64              RD,
    input   uint1               WR_F,
    input   uint5               DESTREG,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    input   uint1               COMMIT_F_ACK,
    output  uint1               COMMIT_F_RESULT_READY,

    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG,

    input   uint10              SBIAS,
    input   uint10              DBIAS,
    input   uint2               RMODE,
    input   uint7               FUNCTION7,                                                                                      // ROUNDING MODE FLAG
    input   uint5               RS2,
    input   int64               I1,                                                                                             // INTEGER SOURCE REGISTER
    input   uint32              I1_ABS32,                                                                                       //  32 BIT ABSOLUTE VALUE
    input   uint64              I1_ABS64,                                                                                       //  64 BIT ABSOLUTE VALUE
    input   uint64              F1,                                                                                             // FLOATING POINT SOURCE REGISTERS
    input   uint64              F1_X,                                                                                           //  REPACKED INTO DOUBLE BIT FIELDS
    input   uint5               F1_TYPE,                                                                                        //  TYPE FLAG
    input   uint64              F1_CP,                                                                                          // FLOATING POINT SOURCE FOR CHANGE PRECISION
    input   uint5               F1_TYPE_CP,                                                                                     //  TYPE FLAG
    output  int64               RESULT,                                                                                         // RESULT
    output  uint5               OUT_FPUFLAGS                                                                                    //  OUTPUT CSR FLAGS
) <reginputs> {
    uint4               STATE = 1;

    uint1               RM_ACTION <:: ( RMODE[0,2] == $RNE$ ) ? 1 :                                                             // ROUNDING MODE MASK FOR FLOATING POINT CONVERSIONS
                                                                                                                                //  RNE
                                      ( RMODE[0,2] == $RTZ$ ) ? 0 :                                                             //  RTZ
                                      ( RMODE[0,2] == $RDN$ ) ? fp64( F1_X ).sign :                                             //  RDN
                                                                   ~fp64( F1_X ).sign;                                          //  RUP

    uint3               converttype <:: {
                                            ( FUNCTION7[2,5] == 5b11000 ),                                                      // FD2IL
                                            ( FUNCTION7[2,5] == 5b11010 ),                                                      // IL2FD
                                            ( FUNCTION7[2,5] == 5b01000 )                                                       // CHANGE PRECISION HSD <-> HSD, FROUND IF RS2[2,1]
                                        };
    uint6               MB[4] = { 29, 0, 42, -1 };                                                                              // SHIFT AMOUNT FOR ROUNDING BIT

    int13               EXP <:: fp64( F1_X ).exponent - DBIAS;                                                                  // EXTRACT EXPONENT AND REMOVE BIAS

    intlong2float FPUIL2F(                                                                                                      // INTEGER TO FLOATING-POINT CONVERSION
        RMODE <: RMODE[0,2], dounsigned <: RS2[0,1], il <: RS2[1,1], dsh <: FUNCTION7[0,2],                                     //  FLAGS ROUNDING, UNSIGNED, 32/64-BIT, HALF/SINGLE/DOUBLE
        BIAS <: DBIAS, MB <: MB[FUNCTION7[0,2]],
        I1 <: I1, I1_ABS32 <: I1_ABS32, I1_ABS64 <: I1_ABS64
    );

    float2intlong FPUF2IL(                                                                                                      // FLOTING-POINT TO INTEGER CONVERSION
        RM_ACTION <: RM_ACTION, dounsigned <: RS2[0,1], domod <: RS2[3,1], il <: RS2[1,1],                                      //  ROUNDING BIT, UNSIGNED, MODULAR CONVERTR, 32/64-BIT
        BIAS <: DBIAS,
        F1_X <: F1_X, F1_TYPE <: F1_TYPE,
        EXP <: EXP
    );

    floatchangeprecision FPUF_CP(                                                                                               // FLOATING-POINT CHANGE PRECISION
        rm <: RMODE, dest <: FUNCTION7[0,2], source <: RS2[0,2],                                                                //  ROUNDING BIT, DESTINATION AND SOUCRE PRECISION
        DBIAS <: DBIAS, SBIAS <: SBIAS, MB <: MB[FUNCTION7[0,2]],
        F1_X <: F1_CP, F1_TYPE <: F1_TYPE_CP
    );

    floatround FPUROUND(                                                                                                        // FLOATING-POINT ROUND ROUNDNX
        RM_ACTION <: RM_ACTION, dsh <: FUNCTION7[0,2], NX <: RS2[0,1],                                                          //  ROUNDING BIT, HALF/SINGLE/DOUBLE, NX
        BIAS <: DBIAS, MB <: MB[FUNCTION7[0,2]],
        F1 <:F1, F1_X <: F1_X, F1_TYPE <: F1_TYPE,
        EXP <: EXP
    );

    COMMIT_RESULT_READY := STATE[3,1] & ~WR_F; COMMIT_F_RESULT_READY := STATE[3,1] & WR_F;
    COMMIT_DESTREG := DESTREG;
    COMMIT_RESULT := converttype[2,1] ? FPUF2IL.RESULT :
                     converttype[1,1] ? FPUIL2F.RESULT :
                             RS2[2,1] ? FPUROUND.RESULT : FPUF_CP.RESULT;
    OUT_FPUFLAGS := converttype[2,1] ? FPUF2IL.OP_FPUFLAGS :
                    converttype[1,1] ? FPUIL2F.OP_FPUFLAGS :
                            RS2[2,1] ? FPUROUND.OP_FPUFLAGS : FPUF_CP.OP_FPUFLAGS;

    always {
        onehot( STATE ) {
            case 0: { RD = START << { WR_F, DESTREG }; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { STATE = 8; }
            case 3: { if( COMMIT_ACK | COMMIT_F_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit fpucalc_fma_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,
    input   uint5               DESTREG,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG,

    input   uint5   ACTION,
    input   uint2   RMODE,                                                                                                      // ROUNDING MODE FLAG
    input   uint2   dsh,                                                                                                        // DOUBLE/SINGLE/HALF FLAG ( to determine START bit )
input   uint10  BIAS,                                                                                                       // FLOATING POINT BIAS
input   uint5   OPCODE,                                                                                                     // OPCODE, SINGLE OR FUSED OPERATIONS
input   uint5   FUNCTION7,                                                                                                  // DETERMINE SINGLE OPERATION
input   uint64  F1_X,                                                                                                      // F1 ( repacked in double bitfields )
input   uint5   F1_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } OF INPUT F1
input   uint64  F2_X,                                                                                                      // F2 ( repacked in double bitfields )
input   uint5   F2_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } OF INPUT F2
input   uint64  F3_X,                                                                                                      // sourceReg3F ( repacked in double bitfields )
input   uint5   F3_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } OF INPUT sourceReg3F
output  uint5   OUT_FPUFLAGS                                                                                               // NEW FPUFLAGS
) <reginputs> {
    uint5               STATE = 1;

    donormalexp NORMAL( exp <: FPUfused.EXP );                                                   // HANDLE NORMALISATION
    doroundcombine MAKERESULT(                                                                                                  // HANDLE ROUNDING AND COMBINING
    rm <: RMODE, dsh <: dsh, BIAS <: BIAS,
    bitstream <: NORMAL.normalfraction
    );

    // FUSED UNIT IS USED FOR   A+B ( AS A*1.0+B )
    //                          A*B ( AS A*B+0.0 )
    //                          FUSED MULTIPLY AND ADD OPERATIONS
    // PASS INPUTS TO FUSED UNITS
    //                          ADDITION        A*1.0+B
    //                          SUBTRACTION     A*1.0-B
    //                          MULTIPLICATION  A*B+0.0
    //                          FUSED           A*B+C ( with sign swaps as needed )
    do_float_multiply MULT( BIAS <: BIAS, F1_X <: F1_X );                                                                     // GENERATE PRODUCT SIGN, FRACTION, EXPONENT : MULTIPLY / FUSED
    floatfused FPUfused(                                                                                                        // FLOAT FUSED-MULTIPLY-ADD
    BIAS <: BIAS,                                                                                                           // BIAS
    productfraction <: MULT.fraction, productexp <: MULT.exp,                                                               // MULTIPLICATION RESULTS
    OF <: MAKERESULT.OF, UF <: MAKERESULT.UF                                                                                // UNDER/OVER FLOW FLAGS FROM WHEN C == 0
    );

    wide_xINF xINF(); wide_xZERO xZERO( sign <: MULT.sign );                                                 // GENERATE SIGNED INFINITY AND ZERO
    repackage_actual CALCRESULT( dsh <: dsh, repack :> COMMIT_RESULT );                                                         // REPACKAGE CALCULATION RESULT INTO CORRECT BITFIELDS

    NORMAL.bitstream := ACTION[1,1] ? MULT.fraction ::                                                 // SELECT BITSTREAM FOR NORMALISATION   MULTIPLICATION
    FPUfused.FRACTION;                                                   //                                      FUSED/ADDSUB
    MAKERESULT.sign := ACTION[1,1] ? MULT.sign :                                                          // SELECT SIGN FOR RESULT               MULTIPLICATION
    FPUfused.SIGN;                                                       //                                      FUSED/ADDSUB
    MAKERESULT.exponent := ACTION[1,1] ? MULT.exp :                                               // SELECT EXPONENT FOR RESULT           MULTIPLICATION
    NORMAL.newexponent;                                               //                                      FUSED/ADDSUB
    MULT.F2_X := ACTION[0,1] ? { 2b0, BIAS, 52b0 } : F2_X;                                               // IF ADDITION AS A*1.0 ELSE A*B
    FPUfused.productsign := ( ~ACTION[1,1] & OPCODE[1,1] ) ^ MULT.sign;                                // SELECTION MULTIPLICATION SIGN, SWITCH IF FUSED NEGATE
    FPUfused.c := ACTION[0,1] ? { FUNCTION7[0,1] ^ fp64( F2_X ).sign, F2_X[0,63] } :                        // ADD/SUB SWITCH SIGN OF B INPUT IF SUBTRACTION
    ACTION[1,1] ? 0 :                                                                           // SET C INPUT TO 0 IF A*B+0.0
    { OPCODE[0,1] ^ fp64( F3_X ).sign, F3_X[0,63] };                            // SWITCH SIGN OF C INPUT IF SUBTRACTION REQUIRED, FUSED
    FPUfused.F3_TYPE := ACTION[0,1] ? F2_TYPE :                                                             // SET TYPE OF C TO TYPE OF B FOR ADDITION/SUBTRACTION
    ACTION[1,1] ? 4b0001 :                                                               // SET TYPE OF C TO 0 FOR MULTIPLICATION
    F3_TYPE;                                                              // SELECT TYPE OF C, FUSED
    xINF.sign := ACTION[4,1] ? FPUfused.productsign : MULT.sign;                                              // SIGNED INFINITY & ZERO FOR MULT ( fused multiply ) AND DIV
    FPUfused.F1_OR_F2_INF := ACTION[0,1] ? F1_TYPE[3,1] : ( F1_TYPE[3,1] | F2_TYPE[3,1] );                                   // SET INF NAN AND ZERO FLAGS FOR ADD & SUB / FUSED
    FPUfused.F1_AND_F2_INF := ACTION[0,1] ? F1_TYPE[3,1] : ( F1_TYPE[3,1] & F2_TYPE[3,1] );
    FPUfused.F1_OR_F2_NAN := ACTION[0,1] ? |F1_TYPE[1,2] : |( F1_TYPE[1,2] | F2_TYPE[1,2] );
    FPUfused.F1_OR_F2_ZERO := ACTION[0,1] ? F1_TYPE[0,1] : ( F1_TYPE[0,1] | F2_TYPE[0,1] );
    FPUfused.F1_AND_F2_ZERO := ACTION[0,1] ? 0 : ( F1_TYPE[0,1] & F2_TYPE[0,1] );

    COMMIT_RESULT_READY := STATE[4,1];
    COMMIT_DESTREG := DESTREG;

    CALCRESULT.a :=                                                       FPUfused.special[3,1] ? xINF.value :                                 // RETURN SIGNED INFINITY FOR DIVIDE OR FUSED
    FPUfused.special[1,1] ? 64h7FF8000000000000 :                        // RETRURN QNAN FROM DIVIDE, SQRT OR FUSED
    FPUfused.special[0,1] ? 0 :                            // RETURN ZERO FROM DIVIDE OR FUSED
    FPUfused.special[4,1] ? FPUfused.c :                                    // RETURN ADDITION INPUT IF MULTIPLY IS 0 FROM FUSED
    MAKERESULT.combined;                         // ELSE RETURN CALCULATION RESULT

    OUT_FPUFLAGS := ACTION[4,1] ? FPUfused.flags :                                                                              //  FUSED MULT-ADD   { NV, --, UF, OF, -- }
    FPUfused.flags & 5b00110;                                                                     //  MULT/ADD/SUB     { --, --, UF, OF, -- }

    always {
        onehot( STATE ) {
            case 0: { RD[ DESTREG,1 ] = START; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { STATE = 8; }
            case 3: { STATE = 16; }
            case 4: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit fpucalc_div_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,
    input   uint5               DESTREG,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG,

    input   uint2   RMODE,                                                                                                      // ROUNDING MODE FLAG
    input   uint2   dsh,                                                                                                        // DOUBLE/SINGLE/HALF FLAG ( to determine START bit )
input   uint10  BIAS,                                                                                                       // FLOATING POINT BIAS
input   uint64  F1_X,                                                                                                      // F1 ( repacked in double bitfields )
input   uint5   F1_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } OF INPUT F1
input   uint64  F2_X,                                                                                                      // F2 ( repacked in double bitfields )
input   uint5   F2_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } OF INPUT F2
output  uint5   OUT_FPUFLAGS                                                                                                // NEW FPUFLAGS
) <reginputs> {
    uint5               STATE = 1;

    donormalexp NORMAL( bitstream <: FPUdivide.fraction);                                                                                  // HANDLE NORMALISATION
    doroundcombine MAKERESULT(                                                                                                  // HANDLE ROUNDING AND COMBINING
    rm <: RMODE, dsh <: dsh, BIAS <: BIAS,
    sign <: RESULT_SIGN, exponent <: FPUdivide.exponent, bitstream <: NORMAL.normalfraction
    );

    uint7               SB[4] = { 49, 107, 23, -1 };                                                                            // DETERMINE STARTING BIT FOR DIVISION
    uint1               RESULT_SIGN <:: F1_X[63,1] ^ F2_X[63,1];
    floatdivide FPUdivide(                                                                                                      // FLOAT DIVISION
    dsh <: dsh,                                                                                                             // DOUBLE/SINGLE/HALF FLAG, BIAS, ROUNDING MODE FLAG
    a <: F1_X, F1_TYPE <: F1_TYPE,                                                                                          // A OPERAND FOR A/B { ZF INF sNAN qNAN ZERO }
    b <: F2_X, F2_TYPE <: F2_TYPE,                                                                                          // B OPERAND FOR A/B { ZF INF sNAN qNAN ZERO }
    SB <: SB[dsh],                                                                                                          // PASS STARTING BIT
    OF <: MAKERESULT.OF, UF <: MAKERESULT.UF ,                                                                               // UNDER/OVER FLOW FLAGS
    flags :> OUT_FPUFLAGS
    );

    wide_xINF xINF(sign <: RESULT_SIGN ); wide_xZERO xZERO( sign <: RESULT_SIGN );                                                                    // GENERATE SIGNED INFINITY AND ZERO
    repackage_actual CALCRESULT( dsh <: dsh, repack :> COMMIT_RESULT );                                                         // REPACKAGE CALCULATION RESULT INTO CORRECT BITFIELDS

    FPUdivide.START := STATE[2,1];                                                                                // START    DIVIDE

    COMMIT_RESULT_READY := STATE[4,1];
    COMMIT_DESTREG := DESTREG;

    CALCRESULT.a :=                                                       FPUdivide.special[3,1] ? xINF.value :                                 // RETURN SIGNED INFINITY FOR DIVIDE OR FUSED
    FPUdivide.special[1,1] ? 64h7FF8000000000000 :                        // RETRURN QNAN FROM DIVIDE, SQRT OR FUSED
    FPUdivide.special[0,1] ? xZERO.value :                            // RETURN ZERO FROM DIVIDE OR FUSED
    MAKERESULT.combined;                           // ELSE RETURN CALCULATION RESULT

    always {
        onehot( STATE ) {
            case 0: { RD[ DESTREG,1 ] = START; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { STATE = 8; }
            case 3: { if( ~FPUdivide.BUSY ) { STATE = 16; } }
            case 4: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit fpucalc_sqrt_execute(
    output  uint1               READY,
    input   uint1               START,
    output  uint32              RD,
    input   uint5               DESTREG,

    input   uint1               COMMIT_ACK,
    output  uint1               COMMIT_RESULT_READY,
    output  uint64              COMMIT_RESULT,
    output  uint5               COMMIT_DESTREG,

    input   uint2   RMODE,                                                                                                      // ROUNDING MODE FLAG
    input   uint2   dsh,                                                                                                        // DOUBLE/SINGLE/HALF FLAG ( to determine START bit )
input   uint10  BIAS,                                                                                                       // FLOATING POINT BIAS
input   uint64  F1_X,                                                                                                      // F1 ( repacked in double bitfields )
input   uint5   F1_TYPE,                                                                                                   // { ZF INF sNAN qNAN ZERO } OF INPUT F1
output  uint5   OUT_FPUFLAGS                                                                                                // NEW FPUFLAGS
) <reginputs> {
    uint5               STATE = 1;

    donormalexp NORMAL( bitstream <: FPUsqrt.fraction );                                                                                  // HANDLE NORMALISATION
    doroundcombine MAKERESULT(                                                                                                  // HANDLE ROUNDING AND COMBINING
    rm <: RMODE, dsh <: dsh, BIAS <: BIAS,
    exponent <: FPUsqrt.exponent, bitstream <: NORMAL.normalfraction
    );

    uint7               SB[4] = { 49, 107, 23, -1 };                                                                            // DETERMINE STARTING BIT FOR DIVISION ( /2 FOR SQUAREROOT )

    // https://projectf.io/posts/square-root-in-verilog/
    floatsqrt FPUsqrt(                                                                                                          // FLOAT SQUARE ROOT
    dsh <: dsh, BIAS <: BIAS,                                                                                               // DOUBLE/SINGLE/HALF FLAG, BIAS
    a <: F1_X, F1_TYPE <: F1_TYPE,                                                                                       // A OPERAND FOR SQRT(A) AND { ZF INF sNAN qNAN ZERO }
                                                                                                                                SB <: SB[dsh][1,6],                                                                                                     // PASS STARTING BIT ( HALF OF DIVISION )
    OF <: MAKERESULT.OF, UF <: MAKERESULT.UF,                                                                                // UNDER/OVER FLOW FLAGS
    flags :> OUT_FPUFLAGS
    );

    wide_xINF xINF(); wide_xZERO xZERO();                                                                    // GENERATE SIGNED INFINITY AND ZERO
    repackage_actual CALCRESULT( dsh <: dsh, repack :> COMMIT_RESULT );                                                         // REPACKAGE CALCULATION RESULT INTO CORRECT BITFIELDS

    FPUsqrt.START := STATE[2,1];                                                                                  //          SQUARE ROOT
    COMMIT_RESULT_READY := STATE[4,1];
    COMMIT_DESTREG := DESTREG;

    CALCRESULT.a :=                                                      FPUsqrt.special[1,1] ? 64h7FF8000000000000 :                        // RETRURN QNAN FROM DIVIDE, SQRT OR FUSED
    FPUsqrt.special[6,1] ? F1_X :                                      // RETURN INPUT FROM SQRT
    MAKERESULT.combined;                           // ELSE RETURN CALCULATION RESULT

    always {
        onehot( STATE ) {
            case 0: { RD[ DESTREG,1 ] = START; if( START ) { READY = 0; STATE = 2; } }
            case 1: { STATE = 4; }
            case 2: { STATE = 8; }
            case 3: { if( ~FPUsqrt.BUSY ) { STATE = 16; } }
            case 4: { if( COMMIT_ACK ) { RD = 0; READY = 1; STATE = 1; } }
        }

        if( reset ) { RD = 0; READY = 1; STATE = 1; }
    }
}

unit csrfpu_commit_i(
    output  uint32              RD,
    output  uint1               RESULT_READY,

    input   uint1               CSR_READY,
    output  uint1               CSR_ACK,
    input   uint64              CSR_RESULT,
    input   uint5               CSR_DESTREG,

    input   uint1               FPUFAST_READY,
    output  uint1               FPUFAST_ACK,
    input   uint64              FPUFAST_RESULT,
    input   uint5               FPUFAST_DESTREG,

    input   uint1               FPUCONVERT_READY,
    output  uint1               FPUCONVERT_ACK,
    input   uint64              FPUCONVERT_RESULT,
    input   uint5               FPUCONVERT_DESTREG,

    input   uint1               COMMIT_EXECUTE_CSRFPU_RESULT_ACK,
    output  uint64              COMMIT_CSRFPU_RESULT,
    output  uint5               COMMIT_CSRFPU_REGISTER
) <reginputs> {
    CSR_ACK := 0;
    FPUFAST_ACK := 0;
    FPUCONVERT_ACK := 0;

    COMMIT_CSRFPU_RESULT := CSR_READY ? CSR_RESULT : FPUCONVERT_READY ? FPUCONVERT_RESULT : FPUFAST_RESULT;
    COMMIT_CSRFPU_REGISTER := CSR_READY ? CSR_DESTREG : FPUCONVERT_READY ? FPUCONVERT_DESTREG : FPUFAST_DESTREG;

    RESULT_READY := CSR_READY | FPUFAST_READY | FPUCONVERT_READY;

    RD := RESULT_READY << (
                                   CSR_READY ? CSR_DESTREG :
                            FPUCONVERT_READY ? FPUCONVERT_DESTREG :
                               FPUFAST_READY ? FPUFAST_DESTREG :
                                               0
                          );

    always {
        if( CSR_READY ) {
            CSR_ACK = COMMIT_EXECUTE_CSRFPU_RESULT_ACK;
        } else {
            if( FPUCONVERT_READY ) {
                FPUCONVERT_ACK = COMMIT_EXECUTE_CSRFPU_RESULT_ACK;
            } else {
                FPUFAST_ACK = FPUFAST_READY & COMMIT_EXECUTE_CSRFPU_RESULT_ACK;
            }
        }
    }
}

unit csrfpu_commit_f(
    output  uint32              RD,
    output  uint1               RESULT_READY,

    input   uint1               FPUFAST_READY,
    output  uint1               FPUFAST_ACK,
    input   uint64              FPUFAST_RESULT,
    input   uint5               FPUFAST_DESTREG,

    input   uint1               FPUCONVERT_READY,
    output  uint1               FPUCONVERT_ACK,
    input   uint64              FPUCONVERT_RESULT,
    input   uint5               FPUCONVERT_DESTREG,

    input   uint1               FPUCALC_FMA_READY,
    output  uint1               FPUCALC_FMA_ACK,
    input   uint64              FPUCALC_FMA_RESULT,
    input   uint5               FPUCALC_FMA_DESTREG,

    input   uint1               FPUCALC_DIV_READY,
    output  uint1               FPUCALC_DIV_ACK,
    input   uint64              FPUCALC_DIV_RESULT,
    input   uint5               FPUCALC_DIV_DESTREG,

    input   uint1               FPUCALC_SQRT_READY,
    output  uint1               FPUCALC_SQRT_ACK,
    input   uint64              FPUCALC_SQRT_RESULT,
    input   uint5               FPUCALC_SQRT_DESTREG,

    input   uint1               COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK,
    output  uint64              COMMIT_CSRFPU_F_RESULT,
    output  uint5               COMMIT_CSRFPU_F_REGISTER
) <reginputs> {
    FPUFAST_ACK := 0;
    FPUCONVERT_ACK := 0;
    FPUCALC_FMA_ACK := 0;
    FPUCALC_DIV_ACK := 0;
    FPUCALC_SQRT_ACK := 0;

    RESULT_READY := FPUFAST_READY | FPUCONVERT_READY | FPUCALC_FMA_READY | FPUCALC_DIV_READY | FPUCALC_SQRT_READY;

    RD := RESULT_READY << (
                            FPUCALC_SQRT_READY ? FPUCALC_SQRT_DESTREG :
                             FPUCALC_DIV_READY ? FPUCALC_DIV_DESTREG :
                             FPUCALC_FMA_READY ? FPUCALC_FMA_DESTREG :
                                 FPUFAST_READY ? FPUFAST_DESTREG :
                              FPUCONVERT_READY ? FPUCONVERT_DESTREG :
                                                 0
                          );

    COMMIT_CSRFPU_F_RESULT := FPUCALC_SQRT_READY ? FPUCALC_SQRT_RESULT :
                               FPUCALC_DIV_READY ? FPUCALC_DIV_RESULT :
                               FPUCALC_FMA_READY ? FPUCALC_FMA_RESULT :
                                   FPUFAST_READY ? FPUFAST_RESULT :
                                FPUCONVERT_READY ? FPUCONVERT_RESULT :
                                                   0;

    COMMIT_CSRFPU_F_REGISTER := FPUCALC_SQRT_READY ? FPUCALC_SQRT_DESTREG :
                                 FPUCALC_DIV_READY ? FPUCALC_DIV_DESTREG :
                                 FPUCALC_FMA_READY ? FPUCALC_FMA_DESTREG :
                                     FPUFAST_READY ? FPUFAST_DESTREG :
                                  FPUCONVERT_READY ? FPUCONVERT_DESTREG :
                                                     0;

    always {
        if( FPUCALC_SQRT_READY ) {
            FPUCALC_SQRT_ACK = COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK;
        } else {
            if( FPUCALC_DIV_READY ) {
                FPUCALC_DIV_ACK = COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK;
            } else {
                if( FPUCALC_FMA_READY ) {
                    FPUCALC_FMA_ACK = COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK;
                } else {
                    if( FPUFAST_READY ) {
                        FPUFAST_ACK = COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK;
                    } else {
                        FPUCONVERT_ACK = FPUCONVERT_READY & COMMIT_EXECUTE_CSRFPU_F_RESULT_ACK;
                    }
                }
            }
        }
    }
}
